{
  "name": "node-qa-blueprint",
  "version": "3.2.0",
  "type": "module",
  "description": "Plantilla base para APIs Node.js corporativas (Linting estricto, Mocking, Profiling, BDD y Mutación)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "node --test tests/contracts/*.test.ts",
    "mutate": "stryker run",
    "audit:deps": "pnpm audit --prod",
    "qa:sbom": "mkdir -p reports && cyclonedx-npm --output-file reports/sbom-node.cdx.json",
    "test:load": "artillery run artillery.yml",
    "profile:cpu": "pnpm run build && clinic flame -- node dist/server.js",
    "profile:memory": "pnpm run build && clinic heapprofiler -- node dist/server.js"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^7.0.1",
    "@eslint/js": "^9.39.4",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "artillery": "^2.0.9",
    "artillery-plugin-expect": "^2.0.0",
    "clinic": "^13.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "nock": "^13.5.4",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-prom-bundle": "^7.0.0",
    "prom-client": "^15.1.0"
  }
}
