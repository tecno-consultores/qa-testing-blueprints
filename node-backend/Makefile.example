.PHONY: qa-lint qa-unit qa-contracts qa-e2e qa-bdd qa-dast qa-mutation qa-sbom qa-stress qa-chaos qa-observability qa-all clean-cache clean qa-clean

# Variables
COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-node-backend
PROJECT_DIR ?= $(CURDIR)
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
export QA_UID QA_GID

qa-lint:
	@echo "🔍 Ejecutando Auditoría de CVEs, Linter y Type Checking (Node.js)..."
	@[ ! -x ./scripts/verificar-secretos.sh ] || ./scripts/verificar-secretos.sh
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "pnpm install --silent && pnpm run audit:deps && pnpm run format:check && pnpm lint && pnpm type-check"

qa-unit:
	@echo "🧪 Ejecutando Pruebas Unitarias (Vitest)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "pnpm install --silent && pnpm run test:coverage"

qa-contracts:
	@echo "🤝 Ejecutando Pruebas de Contrato Pact Zero-Infra (node --test)..."
	@mkdir -p "$(PROJECT_DIR)/pacts"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e PACT_OUTPUT_DIR=/app/pacts $(SERVICE_NAME) bash -c "node --test tests/contracts/*.test.ts"

qa-e2e:
	@echo "🎭 Ejecutando Pruebas BDD (Karate Labs)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile \"*\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile karate run --rm -T karatelabs mvn -B clean test'

qa-dast:
	@echo "🛡️ [11X] Ejecutando Auditoría Dinámica DAST (OWASP ZAP)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile \"*\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile dast run --rm -T -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp -e _JAVA_OPTIONS="-Duser.home=/tmp" zap sh -c "if [ -f /zap/wrk/zap.yaml ]; then zap.sh -cmd -dir /tmp/.ZAP -autorun /zap/wrk/zap.yaml; else zap.sh -dir /tmp/.ZAP -cmd -quickurl http://api:3000 -quickout /reports/zap-report.html; fi"'

qa-mutation:
	@echo "👽 Ejecutando Pruebas de Mutación (Stryker)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c 'mkdir -p /tmp/qa-bin && printf "#!/bin/sh\nexit 0\n" >/tmp/qa-bin/ps && chmod +x /tmp/qa-bin/ps && pnpm install --silent && PATH="/tmp/qa-bin:$$PATH" pnpm run mutate'

qa-sbom:
	@echo "📦 Generando SBOM CycloneDX (Node.js)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "pnpm install --silent && pnpm run qa:sbom"

qa-bdd: qa-e2e

qa-stress:
	@echo "🔥 Ejecutando Pruebas de Carga y Caos (Artillery + Pumba)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile chaos down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile chaos up -d pumba prometheus && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile chaos run --rm -T -u "$(QA_UID):$(QA_GID)" stress_test'

qa-chaos: qa-stress

qa-observability:
	@echo "📈 [11X] Levantando observabilidad (Prometheus)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile observability up -d --wait prometheus

qa-all: qa-lint qa-unit qa-contracts qa-mutation qa-e2e
	@echo "✅ Pipeline QA Node Backend completado."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v --remove-orphans >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v --remove-orphans >/dev/null 2>&1 || true

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
