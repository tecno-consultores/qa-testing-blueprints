{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "/tmp/stryker-incremental.json",
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "playwright-report",
    "lhci-reports",
    "test-results",
    "reports"
  ],
  "concurrency": 4,
  "ignoreStatic": true,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/main.tsx",
    "!src/**/*.unit.ts",
    "!src/**/*.unit.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/**/*.test.tsx",
    "!src/**/*.test.ts"
  ]
}
