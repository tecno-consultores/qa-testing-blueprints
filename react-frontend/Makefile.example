.PHONY: qa-lint qa-unit qa-orphans qa-ci certify qa-mutation qa-perf qa-e2e qa-bdd qa-psi qa-obs qa-all build-ui clean-cache down-caches clean qa-clean

# Variables
COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-frontend
E2E_SERVICE ?= ui-e2e
PROJECT_DIR ?= $(CURDIR)
PYTHON_QA_IMAGE = sinfallas/base-python-uv:3.15@sha256:b5323179c6278cef2775d870fdfb4628f19ec2567430de8774889867961018c4
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
QA_OFFLINE ?= 0
PNPM_INSTALL_CMD = if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile $$([ "$${QA_OFFLINE:-0}" = "1" ] && printf -- "--offline" || printf -- "--prefer-offline") --silent; else pnpm install --silent; fi
export QA_UID QA_GID QA_OFFLINE

build-ui:
	@echo "🏗️ Compilando la aplicación (Vite) para entorno E2E/Producción..."
	@mkdir -p "$(PROJECT_DIR)/dist"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e QA_OFFLINE="$(QA_OFFLINE)" $(SERVICE_NAME) bash -c "$(PNPM_INSTALL_CMD) && pnpm --silent run build"

qa-lint:
	@echo "🔍 Ejecutando Auditoría de CVEs, Linter, Types y Formateo (React/TS)..."
	@[ ! -x ./scripts/verificar-secretos.sh ] || ./scripts/verificar-secretos.sh
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e QA_OFFLINE="$(QA_OFFLINE)" $(SERVICE_NAME) bash -c "$(PNPM_INSTALL_CMD) && ( [ \"\$${QA_OFFLINE:-0}\" = \"1\" ] || pnpm run audit:deps ) && pnpm run type-check && pnpm run format:check && pnpm lint"

qa-unit:
	@echo "🧪 Ejecutando Pruebas Unitarias Aisladas (Vitest + RTL >= 95%)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e QA_OFFLINE="$(QA_OFFLINE)" $(SERVICE_NAME) bash -c "$(PNPM_INSTALL_CMD) && pnpm run test:coverage"

qa-orphans:
	@echo "🧩 [11X] Verificando cero componentes UI huérfanos en Docker (Rule Zero)..."
	@if [ -f .agents/scripts/verify_zero_orphan_vue_components.py ]; then \
		docker run --rm --restart=no --network none --security-opt=no-new-privileges:true -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp -v "$(PROJECT_DIR):/app:ro" -w /app $(PYTHON_QA_IMAGE) python3 .agents/scripts/verify_zero_orphan_vue_components.py; \
	else \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) node -e "const fs=require('fs'),p=require('path');const walk=d=>fs.existsSync(d)?fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(d,e.name)):[p.join(d,e.name)]):[];const tests=walk('src').concat(walk('tests')).concat(walk('test')).filter(f=>/\.(unit|spec|test)\.(ts|tsx|js|jsx)$$/.test(f));const comps=walk('src/components').concat(walk('src/views')).concat(walk('src/pages')).filter(f=>/\.(tsx|jsx)$$/.test(f)&&!f.includes('.unit.')&&!f.includes('.spec.')&&!f.includes('.test.'));const m=comps.filter(c=>{const b=p.basename(c,p.extname(c));return !tests.some(t=>p.basename(t).startsWith(b+'.'));});if(m.length){console.error('Componentes huerfanos:',m);process.exit(1)}"; \
	fi

qa-mutation:
	@echo "👽 Ejecutando Pruebas de Mutación Frontend (Stryker)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c 'mkdir -p /tmp/qa-bin && printf "#!/bin/sh\nexit 0\n" >/tmp/qa-bin/ps && chmod +x /tmp/qa-bin/ps && pnpm install --silent && PATH="/tmp/qa-bin:$$PATH" pnpm run mutate'

qa-perf: build-ui
	@echo "⚡ Ejecutando Auditoría de Rendimiento (Lighthouse CI)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down --remove-orphans >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait --wait-timeout 60 ui-prod && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp $(E2E_SERVICE) bash -c "export CHROME_PATH=\$$(ls -d /ms-playwright/chromium-*/chrome-linux/chrome 2>/dev/null | head -n 1) && if [ -x ./node_modules/.bin/lhci ]; then ./node_modules/.bin/lhci autorun --config=lighthouserc.cjs; elif command -v pnpm >/dev/null 2>&1; then pnpm install --silent && pnpm run test:perf; else corepack pnpm install --silent && corepack pnpm run test:perf; fi"'

qa-e2e: build-ui
	@echo "🎭 Ejecutando Regresión Visual y E2E (Playwright)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down --remove-orphans >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait --wait-timeout 60 ui-prod && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp $(E2E_SERVICE) bash -c "if [ -x ./node_modules/.bin/playwright ]; then ./node_modules/.bin/playwright test; elif command -v pnpm >/dev/null 2>&1; then pnpm install --silent && pnpm exec playwright test; else corepack pnpm install --silent && corepack pnpm exec playwright test; fi"'

qa-bdd: build-ui
	@echo "📚 Ejecutando Pruebas de Aceptación BDD (Karate Contratos HTTP/OSHP/SSG sobre Nginx)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down --remove-orphans >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait --wait-timeout 60 ui-prod && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T karatelabs mvn -B clean test'

qa-psi:
	@echo "🌐 [11X] Ejecutando Auditoría Post-Deploy en Google PageSpeed Insights (Modo Dual)..."
	@target_url="$${PSI_URL:-$(URL)}"; \
	if [ -z "$$target_url" ]; then \
		echo "⚠️ [SKIPPED] Define URL=https://tu-dominio.com (o PSI_URL) para auditar PageSpeed Insights."; \
		exit 0; \
	fi; \
	if [ ! -f .agents/scripts/audit_pagespeed_insights.py ]; then \
		echo "⚠️ [SKIPPED] No se encontró .agents/scripts/audit_pagespeed_insights.py."; \
		exit 0; \
	fi; \
	docker run --rm --restart=no --security-opt=no-new-privileges:true -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp -e PAGESPEED_API_KEY -e PSI_URL="$$target_url" -v "$(PROJECT_DIR):/app" -w /app $(PYTHON_QA_IMAGE) python3 .agents/scripts/audit_pagespeed_insights.py

qa-obs: build-ui
	@echo "📊 Levantando Stack de Observabilidad Frontend..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile observability up -d --wait --wait-timeout 60 prometheus nginx-exporter

qa-ci: qa-lint qa-orphans qa-unit
	@echo "✅ [11X] Paridad Pre-Push 1:1 con CI (lint + orphans + unit) certificada."

certify:
	@[ -x ./.agents/scripts/certify_task_completion.sh ] && ./.agents/scripts/certify_task_completion.sh || echo "⚠️ [SKIPPED] certify_task_completion.sh no instalado."

qa-all: qa-lint qa-orphans qa-unit qa-mutation qa-perf qa-e2e qa-bdd
	@echo "✅ Pipeline QA Frontend (React 11X) completado."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down --remove-orphans >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down --remove-orphans >/dev/null 2>&1 || true

down-caches:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v --remove-orphans >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v --remove-orphans >/dev/null 2>&1 || true

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
