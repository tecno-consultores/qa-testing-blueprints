# Forzar el uso estricto de versiones bloqueadas
engine-strict=true

# Evitar que dependencias arbitrarias ejecuten scripts de post-instalación por defecto (Zero-Trust)
ignore-scripts=true

# Nota: En pnpm v12+ con ignore-scripts=true, las excepciones para binarios nativos
# se declaran en pnpm-workspace.yaml bajo el mapa booleano allowBuilds (nunca en package.json#pnpm).
# Ejemplo en pnpm-workspace.yaml:
# allowBuilds:
#   esbuild: true
#   playwright: true
#   '@playwright/test': true

# Optimización de red y CI
fetch-retries=3
strict-peer-dependencies=false
