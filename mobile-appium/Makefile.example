.PHONY: qa-lint qa-unit qa-ci certify qa-e2e qa-bridge qa-drivers qa-sbom qa-all clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA MOBILE / APPIUM 11X (sinfallas/base-mobile-appium:26)
# ==============================================================================

COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-mobile
BRIDGE_SERVICE ?= appium-bridge
PROJECT_DIR ?= $(CURDIR)
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
export QA_UID QA_GID

qa-lint:
	@echo "🔍 [11X] Verificando secretos, TypeScript estricto, auditoria de dependencias y linter Mobile/Appium..."
	@[ ! -x ./scripts/verificar-secretos.sh ] || ./scripts/verificar-secretos.sh
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e QA_OFFLINE="$${QA_OFFLINE:-0}" $(SERVICE_NAME) bash -c 'set -e; npm_config_yes=true node --version >/dev/null; tsc --strict --noImplicitAny --noUnusedLocals --noUnusedParameters --noImplicitReturns --erasableSyntaxOnly --allowImportingTsExtensions --target ES2023 --module NodeNext --moduleResolution NodeNext --typeRoots /opt/qa11x/node_modules/@types --types node --noEmit wdio.conf.ts tests/screenplay/MobileActor.ts tests/mobile_screenplay.spec.ts tests/e2e/mobile_app_smoke.spec.ts; if [ -f pnpm-lock.yaml ] && [ "$${QA_OFFLINE:-0}" != "1" ]; then pnpm run audit:deps; else echo "⚠️ [SKIPPED] pnpm run audit:deps omitido (requiere pnpm-lock.yaml y conectividad de registro)."; fi; if [ -x ./node_modules/.bin/eslint ]; then pnpm run format:check && pnpm run lint; else echo "⚠️ [SKIPPED] eslint/prettier omitidos (instala devDependencies en proyecto consumidor o ejecuta eslint del monorepo)."; fi'

qa-unit:
	@echo "🧪 [11X] Ejecutando contrato Screenplay Mobile (>= 95% líneas / >= 90% ramas) + Stub W3C WebDriver..."
	@mkdir -p "$(PROJECT_DIR)/coverage"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/mobile_screenplay.spec.ts"

qa-sbom:
	@echo "📦 [11X] Generando SBOM CycloneDX (Mobile Appium)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e QA_OFFLINE="$${QA_OFFLINE:-0}" $(SERVICE_NAME) bash -c 'if [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then /opt/qa11x/node_modules/.bin/cyclonedx-npm --output-file reports/sbom-mobile.cdx.json; elif [ -d node_modules ]; then /opt/qa11x/node_modules/.bin/cyclonedx-npm --ignore-npm-errors --output-file reports/sbom-mobile.cdx.json; elif [ -f pnpm-lock.yaml ] && [ "$${QA_OFFLINE:-0}" != "1" ]; then pnpm install --frozen-lockfile --silent && /opt/qa11x/node_modules/.bin/cyclonedx-npm --ignore-npm-errors --output-file reports/sbom-mobile.cdx.json; else echo "⚠️ [INFO] Sin lockfile/node_modules del consumidor; exportando SBOM base de sinfallas/base-mobile-appium:26." && cp /opt/qa11x/sbom.cdx.json reports/sbom-mobile.cdx.json; fi'

qa-drivers:
	@echo "📱 [11X] Auditando OpenJDK 21, Android ADB y drivers Appium 3 instalados..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "java -version && adb version && appium --version && appium driver list --installed"

qa-bridge:
	@echo "🔌 [11X] Levantando Appium Driver Bridge W3C en puerto 4723..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile appium-live up -d --wait --wait-timeout 60 $(BRIDGE_SERVICE)

qa-e2e:
	@echo "📲 [11X] Ejecutando suite WebdriverIO v9 contra Appium Driver Bridge..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile appium-live down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile appium-live up -d --wait --wait-timeout 60 $(BRIDGE_SERVICE) && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e APPIUM_HOST=$(BRIDGE_SERVICE) $(SERVICE_NAME) bash -c "wdio run wdio.conf.ts"'

qa-ci: qa-lint qa-unit
	@echo "✅ [11X] Paridad Pre-Push 1:1 con CI (lint + unit Mobile) certificada."

certify:
	@[ -x ./.agents/scripts/certify_task_completion.sh ] && ./.agents/scripts/certify_task_completion.sh || echo "⚠️ [SKIPPED] certify_task_completion.sh no instalado."

qa-all: qa-lint qa-drivers qa-unit
	@echo "✅ [11X] Pipeline QA Mobile Appium completado en contenedor efímero."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile appium-live down -v >/dev/null 2>&1 || true

clean: clean-cache
	@if [ -x ./limpieza.sh ]; then ./limpieza.sh; else docker run --rm --network none --restart=no --security-opt=no-new-privileges:true alpine:3.21@sha256:bc21487101ae47172509130ee1092cc273a831968d64b617776d1f69c81e42ab true; fi

qa-clean: clean
