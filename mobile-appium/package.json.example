{
  "name": "mobile-appium-qa-blueprint",
  "version": "3.0.0",
  "description": "Plantilla QA 11X Mobile/Hybrid (Appium 3 + WebdriverIO v9 + Screenplay RBAC Multi-Tenant) sobre sinfallas/base-mobile-appium:26",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "type-check": "tsc --strict --noImplicitAny --noUnusedLocals --noUnusedParameters --noImplicitReturns --erasableSyntaxOnly --allowImportingTsExtensions --target ES2023 --module NodeNext --moduleResolution NodeNext --typeRoots /opt/qa11x/node_modules/@types --types node --noEmit wdio.conf.ts tests/screenplay/MobileActor.ts tests/mobile_screenplay.spec.ts",
    "test:unit": "node --test tests/mobile_screenplay.spec.ts",
    "test:e2e": "wdio run wdio.conf.ts",
    "appium:drivers": "appium driver list --installed",
    "adb:devices": "adb devices -l",
    "audit:deps": "pnpm audit --prod"
  },
  "dependencies": {
    "webdriverio": "^9.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@wdio/appium-service": "^9.16.0",
    "@wdio/cli": "^9.16.0",
    "@wdio/local-runner": "^9.16.0",
    "@wdio/mocha-framework": "^9.16.0",
    "@wdio/spec-reporter": "^9.16.0",
    "appium": "^3.0.0",
    "typescript": "^5.8.2"
  }
}
