{
  "name": "mobile-appium-qa-blueprint",
  "version": "3.10.0",
  "description": "Plantilla QA 11X Mobile/Hybrid (Appium 3 + WebdriverIO v9 + Screenplay RBAC Multi-Tenant) sobre sinfallas/base-mobile-appium:26",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "type-check": "tsc --strict --noImplicitAny --noUnusedLocals --noUnusedParameters --noImplicitReturns --erasableSyntaxOnly --allowImportingTsExtensions --target ES2023 --module NodeNext --moduleResolution NodeNext --typeRoots /opt/qa11x/node_modules/@types --types node --noEmit wdio.conf.ts tests/screenplay/MobileActor.ts tests/mobile_screenplay.spec.ts tests/e2e/mobile_app_smoke.spec.ts",
    "lint": "eslint \"wdio.conf.ts\" \"tests/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"wdio.conf.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"wdio.conf.ts\" \"tests/**/*.ts\"",
    "test:unit": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/mobile_screenplay.spec.ts",
    "test:e2e": "wdio run wdio.conf.ts",
    "appium:drivers": "appium driver list --installed",
    "adb:devices": "adb devices -l",
    "audit:deps": "pnpm audit --prod",
    "qa:sbom": "mkdir -p reports && cyclonedx-npm --ignore-npm-errors --output-file reports/sbom-mobile.cdx.json"
  },
  "dependencies": {
    "webdriverio": "^9.16.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^7.0.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "@wdio/appium-service": "^9.16.0",
    "@wdio/cli": "^9.16.0",
    "@wdio/local-runner": "^9.16.0",
    "@wdio/mocha-framework": "^9.16.0",
    "@wdio/spec-reporter": "^9.16.0",
    "appium": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "prettier": "^3.2.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.73.0"
  }
}
