{
  "name": "@sinfallas/mcp-qa-11x",
  "version": "3.2.0",
  "description": "Official MCP Server & Thin-Repo Skill Installer for QA Testing Blueprints (QA-11X v3.2: 19 Tools, 13 Resources, AI Evals, FINOS CALM, Screenplay & DevSecOps)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "qa",
    "testing",
    "blueprints",
    "devsecops",
    "ai-evals",
    "deepeval",
    "promptfoo",
    "finos-calm",
    "screenplay",
    "vibe-coding",
    "disa-stig",
    "owasp",
    "karate-labs",
    "graphify",
    "ast",
    "docker",
    "antigravity",
    "claude",
    "cursor",
    "hermes-agent",
    "vscode",
    "github-copilot",
    "codex",
    "windsurf",
    "jetbrains",
    "cline",
    "roo-code",
    "gemini-cli"
  ],
  "homepage": "https://github.com/tecno-consultores/qa-testing-blueprints",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecno-consultores/qa-testing-blueprints.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/tecno-consultores/qa-testing-blueprints/issues"
  },
  "author": "Jesus Palencia <sinfallas@gmail.com> (Creado en Tecno Consultores)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent-card": {
      "types": "./dist/a2a/agentCard.d.ts",
      "default": "./dist/a2a/agentCard.js"
    }
  },
  "bin": {
    "mcp-qa-11x": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md",
    "README.es.md",
    "CHANGELOG.md",
    "CHANGELOG.es.md"
  ],
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --max-warnings 0",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=4096\" tsc -p tsconfig.typecheck.json --noEmit",
    "test:unit": "vitest run --coverage",
    "test:example": "node example/run-example-e2e.mjs",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
