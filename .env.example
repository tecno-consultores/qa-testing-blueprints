# ==============================================================================
# INSTRUCCIONES:
# 1. Copie este archivo como '.env' en la raíz:
#    cp .env.example .env
# 2. Reemplace el valor de NPM_TOKEN con su token real de npmjs.com.
# 3. NUNCA agregue el archivo '.env' a Git (está en .gitignore y protegido por
#    scripts/verificar-secretos.sh).
# ==============================================================================

# Token de autenticación de npmjs.com con permisos de publicación ("Read and Write" o "Automation").
# Genérelo en: https://www.npmjs.com/settings/<tu-usuario>/tokens
# Formato típico: npm_TU_TOKEN_DE_NPMJS_AQUI
NPM_TOKEN=npm_TU_TOKEN_DE_NPMJS_AQUI

# Registro oficial de npm (opcional, por defecto: https://registry.npmjs.org/)
# NPM_REGISTRY=https://registry.npmjs.org/
