[tox]
env_list = py310, py311, py312, py313
isolated_build = True

[testenv]
description = Instala dependencias con uv y ejecuta QA, auditoría de seguridad y pruebas de la API
deps = 
    .[dev]
commands =
    # 1. Linting y Tipado
    ruff check src/ tests/
    ruff format --check src/ tests/
    mypy --strict src/
    
    # 2. Seguridad estática y de paquetes
    uv pip audit
    bandit -c pyproject.toml -r src/
    
    # 3. Pruebas internas (TestClient) y cobertura
    pytest --cov=src/ --cov-fail-under=95 --cov-report=term-missing
    
    # Nota: schemathesis y locust se ejecutan fuera de tox, atacando el servicio vivo.
