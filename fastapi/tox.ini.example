[tox]
env_list = py310, py311, py312, py313
isolated_build = True

[testenv]
description = Instala dependencias con uv y ejecuta QA, complejidad, auditoría de seguridad y pruebas de la API
deps = 
    .[dev]
commands =
    # 1. Linting y Tipado
    ruff check src/ tests/
    ruff format --check src/ tests/
    mypy --strict src/
    
    # 2. Análisis de Complejidad Estricta (Bloquea si el código es espagueti)
    # Falla si detecta complejidad Ciclomática grado C o peor
    radon cc --min C src/
    # Falla si el Índice de Mantenibilidad cae a B o peor
    radon mi --min B src/
    
    # 3. Seguridad estática y auditoría de paquetes de terceros
    uv pip audit
    bandit -c pyproject.toml -r src/
    
    # 4. Pruebas internas aisladas (TestClient + pytest-mock) y validación de cobertura 95%
    pytest --cov=src/ --cov-fail-under=95 --cov-report=term-missing
    
    # Nota: schemathesis, locust, Karate y py-spy se ejecutan fuera de tox, atacando el servicio vivo orquestado.
