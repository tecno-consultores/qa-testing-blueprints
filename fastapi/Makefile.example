.PHONY: qa-lint qa-unit qa-migration qa-integration qa-contracts qa-load qa-ci qa-mutation qa-bdd qa-dast qa-profile qa-chaos qa-all clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA FASTAPI (ESTÁNDAR CORPORATIVO 11X)
# ==============================================================================

COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-backend
PROJECT_DIR ?= $(CURDIR)
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
export QA_UID QA_GID

qa-lint:
	@echo "🔍 [11X] Ejecutando Ruff, Mypy Strict, Radon (Complejidad), Bandit SAST y Auditoría de CVEs..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run ruff check src/ tests/ && \
		uv run ruff format --check src/ tests/ && \
		uv run mypy --strict --cache-dir=/tmp/mypy src/ && \
		test -z \"\$$(uv run radon cc --min B src/)\" && \
		test -z \"\$$(uv run radon mi --min B src/)\" && \
		uv run bandit -c pyproject.toml -q -r src/ && \
		uv run pip-audit"

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias Aisladas y Cobertura Innegociable >= 95% (Pytest)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run pytest -q --tb=short -m 'not integration' --cov-report=term-missing:skip-covered"

qa-migration:
	@echo "🗄️ [11X] Verificando paridad ORM vs Migraciones Alembic en Docker (Rule Zero)..."
	@bash -c 'if [ -f .agents/scripts/verify_alembic_orm_parity.py ]; then \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) python3 .agents/scripts/verify_alembic_orm_parity.py; \
	else \
		trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait postgres && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "\
			uv sync --all-extras -q && \
			DATABASE_URL=\"\$$MIGRATION_DATABASE_URL\" uv run alembic upgrade head && \
			DATABASE_URL=\"\$$MIGRATION_DATABASE_URL\" uv run alembic check"; \
	fi'

qa-integration:
	@echo "🔗 [11X] Ejecutando Suite de Integración Efímera contra PostgreSQL 17 + KeyDB (Rule Zero)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait postgres keydb && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app $(SERVICE_NAME) bash -c "\
			uv sync --all-extras -q && \
			( [ ! -f alembic.ini ] || DATABASE_URL=\"\$$MIGRATION_DATABASE_URL\" uv run alembic upgrade head ) && \
			{ uv run pytest -q --tb=short --no-cov -m integration; rc=\$$?; if [ \$$rc -eq 5 ]; then echo \"⚠️ [SKIPPED] 0 pruebas con marcador @pytest.mark.integration.\"; exit 0; fi; exit \$$rc; }"'

qa-contracts:
	@echo "🤝 [11X] Ejecutando Contratos Zero-Infra (Pact V4) en Docker (Rule Zero)..."
	@mkdir -p "$(PROJECT_DIR)/pacts"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e PACT_OUTPUT_DIR=/app/pacts -e PYTHONPATH=/app $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run pytest -q --tb=short --no-cov tests/contracts/"

qa-load:
	@echo "⚡ [11X] Ejecutando Pruebas de Carga Base (k6 HTTP Smoke + Idempotency-Key Batch)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile load down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait postgres keydb api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile load run --rm -T -u "$(QA_UID):$(QA_GID)" k6-smoke'

qa-ci: qa-lint qa-unit qa-migration qa-integration qa-contracts
	@echo "✅ [11X] Paridad Pre-Push 1:1 con CI (lint + unit + migration + integration + contracts) certificada."

qa-mutation:
	@echo "👽 [11X] Ejecutando Pruebas de Mutación (Mutmut)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run mutmut run && \
		uv run mutmut results"

qa-bdd:
	@echo "📚 [11X] Ejecutando Pruebas BDD de Caja Negra (Karate Labs API)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait postgres keydb api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T karatelabs mvn -B clean test'

qa-dast:
	@echo "🛡️ [11X] Ejecutando Auditoría Dinámica DAST (OWASP ZAP)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait postgres keydb api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp zap zap-baseline.py -t http://api:8000 -r zap-report.html'

qa-profile:
	@echo "🔥 [11X] Capturando Flamegraph py-spy sobre proceso uvicorn (profile.svg en /app)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait postgres keydb api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" exec -T -u "$(QA_UID):$(QA_GID)" api bash -c "\
			pid=\$$(pgrep -f uvicorn | head -n 1); \
			[ -n \"\$$pid\" ] || pid=1; \
			/tmp/qa-venv/bin/py-spy record -o /app/profile.svg --subprocesses --pid \"\$$pid\" --duration 15"'

qa-chaos:
	@echo "💥 [11X] Ejecutando Ingeniería del Caos (Pumba + Prometheus + Locust)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile chaos down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile chaos up --abort-on-container-exit --exit-code-from stress_test'

qa-all: qa-lint qa-unit qa-migration qa-integration qa-contracts qa-mutation qa-bdd
	@echo "✅ Pipeline QA Backend (FastAPI 11X) completado exitosamente."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
