.PHONY: qa-lint qa-unit qa-migration qa-integration qa-ci qa-mutation qa-bdd qa-dast qa-chaos qa-all clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA FASTAPI (ESTÁNDAR CORPORATIVO 11X)
# ==============================================================================

COMPOSE_FILE = docker-compose.qa.yml
SERVICE_NAME = qa-backend

qa-lint:
	@echo "🔍 [11X] Ejecutando Ruff, Mypy Strict, Radon (Complejidad), Bandit SAST y Auditoría de CVEs..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run ruff check src/ tests/ && \
		uv run ruff format --check src/ tests/ && \
		uv run mypy --strict --cache-dir=/tmp/mypy src/ && \
		test -z \"\$$(uv run radon cc --min B src/)\" && \
		test -z \"\$$(uv run radon mi --min B src/)\" && \
		uv run bandit -c pyproject.toml -q -r src/ && \
		uv run pip-audit"

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias Aisladas y Cobertura Innegociable >= 95% (Pytest)..."
	@docker compose -f $(COMPOSE_FILE) run --rm -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app/src $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run pytest -q --tb=short --import-mode=importlib -m 'not integration' --cov=src --cov-fail-under=95 --cov-report=term-missing:skip-covered --cov-report=html:/tmp/htmlcov"

qa-migration:
	@echo "🗄️ [11X] Verificando paridad ORM vs Migraciones Alembic en Docker (Rule Zero)..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) bash -c "\
		if [ -f .agents/scripts/verify_alembic_orm_parity.py ]; then \
			python3 .agents/scripts/verify_alembic_orm_parity.py; \
		else \
			uv sync --all-extras -q && uv run alembic check; \
		fi"

qa-integration:
	@echo "🔗 [11X] Ejecutando Suite de Integración Efímera contra PostgreSQL 17 + KeyDB (Rule Zero)..."
	@bash -c 'trap "docker compose -f $(COMPOSE_FILE) down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose -f $(COMPOSE_FILE) up -d --wait postgres keydb && \
		docker compose -f $(COMPOSE_FILE) run --rm -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app/src $(SERVICE_NAME) bash -c "\
			uv sync --all-extras -q && \
			( [ ! -f alembic.ini ] || uv run alembic upgrade head ) && \
			( uv run pytest -q --tb=short --import-mode=importlib -m integration || [ \$$? -eq 5 ] )"'

qa-ci: qa-lint qa-unit qa-migration qa-integration
	@echo "✅ [11X] Paridad Pre-Push 1:1 con CI (lint + unit + migration + integration) certificada."

qa-mutation:
	@echo "👽 [11X] Ejecutando Pruebas de Mutación (Mutmut)..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run mutmut run && \
		uv run mutmut results"

qa-bdd:
	@echo "📚 [11X] Ejecutando Pruebas BDD de Caja Negra (Karate Labs API)..."
	@docker compose -f $(COMPOSE_FILE) up -d api postgres keydb
	@docker compose -f $(COMPOSE_FILE) run --rm karatelabs mvn -B clean test

qa-dast:
	@echo "🛡️ [11X] Ejecutando Auditoría Dinámica DAST (OWASP ZAP)..."
	@docker compose -f $(COMPOSE_FILE) up -d api postgres keydb
	@docker compose -f $(COMPOSE_FILE) run --rm zap zap-baseline.py -t http://api:8000 -r zap-report.html

qa-chaos:
	@echo "💥 [11X] Ejecutando Ingeniería del Caos (Pumba + Prometheus + Locust)..."
	@docker compose -f $(COMPOSE_FILE) --profile chaos up --abort-on-container-exit

qa-all: qa-lint qa-unit qa-migration qa-mutation qa-bdd
	@echo "✅ Pipeline QA Backend (FastAPI 11X) completado exitosamente."

clean-cache:
	@docker compose -f $(COMPOSE_FILE) down -v >/dev/null 2>&1 || true
	@docker compose -f $(COMPOSE_FILE) --profile chaos down -v >/dev/null 2>&1 || true

clean:
	@./limpieza.sh

qa-clean: clean
