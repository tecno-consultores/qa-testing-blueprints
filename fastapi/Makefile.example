.PHONY: qa-lint qa-unit qa-migration qa-integration qa-contracts qa-load qa-perf qa-ci certify qa-mutation qa-bdd qa-dast qa-profile qa-chaos qa-observability qa-sbom qa-all clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA FASTAPI (ESTÁNDAR CORPORATIVO 11X)
# ==============================================================================

COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-backend
PROJECT_DIR ?= $(CURDIR)
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
QA_OFFLINE ?= 0
UV_SYNC_CMD = if [ -f uv.lock ]; then uv sync --frozen --all-extras -q $$([ "$${QA_OFFLINE:-0}" = "1" ] && printf -- "--offline"); else uv sync --all-extras -q; fi
export QA_UID QA_GID QA_OFFLINE

qa-lint:
	@echo "🔍 [11X] Ejecutando Ruff, Mypy Strict, Radon (Complejidad), Bandit SAST y Auditoría de CVEs..."
	@[ ! -x ./scripts/verificar-secretos.sh ] || ./scripts/verificar-secretos.sh
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e QA_OFFLINE="$(QA_OFFLINE)" $(SERVICE_NAME) bash -c "\
		$(UV_SYNC_CMD) && \
		uv run ruff check src/ tests/ && \
		uv run ruff format --check src/ tests/ && \
		uv run mypy --strict --cache-dir=/tmp/mypy src/ && \
		test -z \"\$$(uv run radon cc --min B src/)\" && \
		test -z \"\$$(uv run radon mi --min B src/)\" && \
		uv run bandit -c pyproject.toml -q -r src/ && \
		( [ \"\$${QA_OFFLINE:-0}\" = \"1\" ] || uv run pip-audit )"

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias Aisladas y Cobertura Innegociable >= 95% (Pytest + coverage.xml)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e QA_OFFLINE="$(QA_OFFLINE)" -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app/src $(SERVICE_NAME) bash -c "\
		$(UV_SYNC_CMD) && \
		uv run pytest -q --tb=short -m 'not integration' --cov-report=xml:coverage.xml --cov-report=term-missing:skip-covered"

qa-migration:
	@echo "🗄️ [11X] Verificando paridad ORM vs Migraciones Alembic en Docker (Rule Zero)..."
	@if [ -f .agents/scripts/verify_alembic_orm_parity.py ]; then docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) python3 .agents/scripts/verify_alembic_orm_parity.py; fi
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait --wait-timeout 60 postgres && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "\
			uv sync --all-extras -q && \
			DATABASE_URL=\"\$$MIGRATION_DATABASE_URL\" uv run alembic upgrade head && \
			DATABASE_URL=\"\$$MIGRATION_DATABASE_URL\" uv run alembic check"'

qa-integration:
	@echo "🔗 [11X] Ejecutando Suite de Integración Efímera contra PostgreSQL 17 + KeyDB (Rule Zero)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait --wait-timeout 60 postgres keydb && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app/src $(SERVICE_NAME) bash -c "\
			uv sync --all-extras -q && \
			( [ ! -f alembic.ini ] || DATABASE_URL=\"\$$MIGRATION_DATABASE_URL\" uv run alembic upgrade head ) && \
			{ uv run pytest -q --tb=short --no-cov -m integration; rc=\$$?; if [ \$$rc -eq 5 ]; then echo \"⚠️ [SKIPPED] 0 pruebas con marcador @pytest.mark.integration.\"; exit 0; fi; exit \$$rc; }"'

qa-contracts:
	@echo "🤝 [11X] Ejecutando Contratos Zero-Infra (Pact V4) en Docker (Rule Zero)..."
	@mkdir -p "$(PROJECT_DIR)/pacts"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e PACT_OUTPUT_DIR=/app/pacts -e PYTHONPATH=/app/src $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run pytest -q --tb=short --no-cov tests/contracts/"

qa-load:
	@echo "⚡ [11X] Ejecutando Pruebas de Carga Base (k6 HTTP Smoke + Idempotency-Key Batch)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile load down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait --wait-timeout 60 postgres keydb api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile load run --rm -T -u "$(QA_UID):$(QA_GID)" k6-smoke'

qa-perf: qa-load

qa-ci: qa-lint qa-unit qa-migration qa-integration qa-contracts
	@echo "✅ [11X] Paridad Pre-Push 1:1 con CI (lint + unit + migration + integration + contracts) certificada."

certify:
	@[ -x ./.agents/scripts/certify_task_completion.sh ] && ./.agents/scripts/certify_task_completion.sh || echo "⚠️ [SKIPPED] certify_task_completion.sh no instalado."

qa-mutation:
	@echo "👽 [11X] Ejecutando Pruebas de Mutación (Mutmut + Gate MSI >= 80%)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app/src $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run mutmut run && \
		(uv run mutmut results --all true || uv run mutmut results) && \
		( [ ! -f mutmut_gates.py ] || uv run python3 mutmut_gates.py )"

qa-bdd:
	@echo "📚 [11X] Ejecutando Pruebas BDD de Caja Negra (Karate Labs API)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait --wait-timeout 60 postgres keydb api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T karatelabs mvn -B clean test'

qa-dast:
	@echo "🛡️ [11X] Ejecutando Auditoría Dinámica DAST (OWASP ZAP)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait --wait-timeout 60 postgres keydb api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp -e _JAVA_OPTIONS="-Duser.home=/tmp" zap sh -c "if [ -f /zap/wrk/zap.yaml ]; then zap.sh -dir /tmp/.ZAP -cmd -autorun /zap/wrk/zap.yaml; else zap.sh -dir /tmp/.ZAP -cmd -quickurl http://api:8000 -quickout /reports/zap-report.html; fi"'

qa-profile:
	@echo "🔥 [11X] Capturando Flamegraph py-spy sobre proceso uvicorn (reports/flamegraph.svg)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@sh -c 'set -eu; trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile profile down -v --remove-orphans >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile profile up -d --wait --wait-timeout 60 postgres keydb api; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile profile run --rm -T profiler'

qa-chaos:
	@echo "💥 [11X] Ejecutando Ingeniería del Caos (Pumba + Prometheus + Locust)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile chaos down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" up -d --wait --wait-timeout 60 postgres keydb api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile chaos up -d pumba prometheus && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile chaos run --rm -T -u "$(QA_UID):$(QA_GID)" stress_test'

qa-observability:
	@echo "📈 [11X] Levantando observabilidad (Prometheus)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile observability up -d --wait --wait-timeout 60 prometheus

qa-sbom:
	@echo "📜 [11X] Generando SBOM CycloneDX..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "uv sync --all-extras -q && uv run cyclonedx-py environment --of JSON -o reports/sbom.cdx.json"

qa-all: qa-lint qa-unit qa-migration qa-integration qa-contracts qa-mutation qa-bdd
	@echo "✅ Pipeline QA Backend (FastAPI 11X) completado exitosamente."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
