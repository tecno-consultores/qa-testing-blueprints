"""Plantilla de prueba unitaria AST para blindar despliegues productivos (--no-dev).

Previene caidas de arranque en produccion causadas por:
1. Importacion de paquetes `[project.optional-dependencies].dev` en `src/`.
2. Exposicion de `/docs`, `/redoc` u `/openapi.json` con `APP_ENV=production`.
3. Fuga de detalles de esquemas en errores `422` en produccion.
"""

import ast
import json
import os
from pathlib import Path
from typing import Any
from unittest.mock import MagicMock, patch

import pytest

# Lista de paquetes y modulos reservados estrictamente para desarrollo y pruebas
FORBIDDEN_DEV_MODULES = {
    "pytest",
    "pytest_asyncio",
    "pytest_cov",
    "pytest_mock",
    "hypothesis",
    "freezegun",
    "radon",
    "mutmut",
    "schemathesis",
    "locust",
    "bandit",
    "pip_audit",
    "cyclonedx",
    "ruff",
    "mypy",
    "tox",
    "tox_uv",
    "py_spy",
    "pact",
    "unittest.mock",
}


def _resolve_src_dir() -> Path:
    base = Path(__file__).resolve().parent.parent
    if base.name == "mutants" and (base.parent / "src").is_dir():
        return base.parent / "src"
    candidate = base / "src"
    if candidate.is_dir():
        return candidate
    return base.parent / "src"


def _extract_imported_names(node: ast.AST) -> list[str]:
    if isinstance(node, ast.Import):
        return [alias.name for alias in node.names]
    if isinstance(node, ast.ImportFrom) and node.module:
        names = [node.module]
        names.extend(
            f"{node.module}.{alias.name}" for alias in node.names if alias.name != "*"
        )
        return names
    return []


def _find_dev_import_violations(file_path: Path) -> list[str]:
    tree = ast.parse(file_path.read_text(encoding="utf-8"), filename=str(file_path))
    violations: list[str] = []
    for node in ast.walk(tree):
        for full_name in _extract_imported_names(node):
            root_name = full_name.split(".")[0]
            if root_name in FORBIDDEN_DEV_MODULES or full_name in FORBIDDEN_DEV_MODULES:
                lineno = getattr(node, "lineno", 1)
                violations.append(
                    f"{file_path.name}:{lineno} importa modulo dev '{full_name}'"
                )
    return violations


def test_no_dev_dependencies_imported_in_production_source() -> None:
    """Verifica via AST que src/ no importe dependencias exclusivas de dev."""
    src_dir = _resolve_src_dir()
    assert src_dir.is_dir(), f"Directorio src no encontrado en {src_dir}"

    python_files = list(src_dir.rglob("*.py"))
    assert python_files, "No se encontraron archivos Python en src/"

    violations: list[str] = []
    for file_path in python_files:
        violations.extend(_find_dev_import_violations(file_path))

    assert not violations, "Importaciones dev en src/:\n" + "\n".join(violations)


def _restore_app_env(
    prev_env: str | None,
    prev_setting: object,
    settings_obj: Any,
) -> None:
    if prev_env is None:
        os.environ.pop("APP_ENV", None)
    else:
        os.environ["APP_ENV"] = prev_env
    if prev_setting is not None:
        settings_obj.APP_ENV = prev_setting


def test_production_app_instantiation_without_docs_and_swagger() -> None:
    """Valida que create_app en produccion desactive Swagger, Redoc y OpenAPI."""
    from main import create_app, settings

    prev_env = os.environ.get("APP_ENV")
    prev_setting = getattr(settings, "APP_ENV", None)
    try:
        os.environ["APP_ENV"] = "production"
        settings.APP_ENV = "production"
        app = create_app()
        assert app.docs_url is None, "docs_url debe ser None en produccion"
        assert app.redoc_url is None, "redoc_url debe ser None en produccion"
        assert app.openapi_url is None, "openapi_url debe ser None en produccion"
    finally:
        _restore_app_env(prev_env, prev_setting, settings)


@pytest.mark.asyncio
async def test_validation_exception_handler_sanitization() -> None:
    """Valida que errores 422 de Pydantic se saniticen en produccion."""
    from fastapi.exceptions import RequestValidationError
    from starlette.requests import Request

    from main import create_app

    scope = {"type": "http", "method": "POST", "path": "/api/v1/test", "headers": []}
    fake_request = Request(scope)
    mock_exc = MagicMock(spec=RequestValidationError)
    mock_exc.errors.return_value = [
        {"loc": ["body", "password"], "msg": "field required", "type": "missing"}
    ]

    with (
        patch.dict(os.environ, {"APP_ENV": "production"}, clear=False),
        patch("main.settings.APP_ENV", "production"),
    ):
        app_prod = create_app()
        handler = app_prod.exception_handlers[RequestValidationError]
        resp_prod = await handler(fake_request, mock_exc)
        assert resp_prod.status_code == 422
        assert json.loads(resp_prod.body) == {
            "detail": (
                "Los datos proporcionados no cumplen con los requisitos de validación."
            )
        }
