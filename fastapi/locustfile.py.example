import uuid
from locust import HttpUser, task, between


class FastApiStressUser(HttpUser):
    # Simula latencia natural entre acciones de usuario (1 a 3 segundos)
    wait_time = between(1, 3)

    def on_start(self) -> None:
        """Simula un proceso de autenticación o preparación antes de ejercitar la API."""
        self.headers = {"Content-Type": "application/json"}
        self.token = "Bearer test-load-token-123"

    @task(3)
    def check_health(self) -> None:
        """Simula múltiples lecturas concurrentes de estado."""
        self.client.get("/health", headers=self.headers)

    @task(2)
    def query_paginated_items(self) -> None:
        """Ejercita endpoints paginados de lectura para evaluar si bloquean el Event Loop asíncrono."""
        req_headers = {**self.headers, "Authorization": self.token}
        self.client.get("/api/v1/items?limit=100", headers=req_headers)

    @task(1)
    def invalid_login_attempt(self) -> None:
        """Genera carga enviando peticiones POST con Idempotency-Key dinámica para validar Pydantic y límites."""
        payload = {"username": "load_test", "password": "InvalidLoadTestPassword123!"}
        req_headers = {**self.headers, "Idempotency-Key": str(uuid.uuid4())}
        with self.client.post("/api/v1/auth/login", json=payload, headers=req_headers, catch_response=True) as resp:
            if resp.status_code in (401, 429):
                resp.success()
