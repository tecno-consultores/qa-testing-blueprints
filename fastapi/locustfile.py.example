import os
import uuid

from locust import HttpUser, between, task


class FastApiStressUser(HttpUser):
    # Simula latencia natural entre acciones de usuario (1 a 3 segundos)
    wait_time = between(1, 3)

    def on_start(self) -> None:
        """Configura cabeceras base y token opcional desde LOCUST_AUTH_TOKEN."""
        self.headers = {"Content-Type": "application/json"}
        raw_token = os.getenv("LOCUST_AUTH_TOKEN", "").strip()
        if raw_token and not raw_token.lower().startswith("bearer "):
            self.token = f"Bearer {raw_token}"
        else:
            self.token = raw_token

    @task(3)
    def check_health(self) -> None:
        """Simula múltiples lecturas concurrentes de estado."""
        self.client.get("/health", headers=self.headers)

    @task(2)
    def query_paginated_items(self) -> None:
        """Ejercita endpoints paginados de lectura sin fallar en 401 si no hay token."""
        req_headers = dict(self.headers)
        if self.token:
            req_headers["Authorization"] = self.token
        with self.client.get(
            "/api/v1/items?limit=100", headers=req_headers, catch_response=True
        ) as resp:
            if not self.token and resp.status_code == 401:
                resp.success()

    @task(1)
    def invalid_login_attempt(self) -> None:
        """Envía POST con Idempotency-Key dinámica para validar Pydantic y límites."""
        payload = {"username": "load_test", "password": "invalid-placeholder-pass"}
        req_headers = {**self.headers, "Idempotency-Key": str(uuid.uuid4())}
        with self.client.post(
            "/api/v1/auth/login",
            json=payload,
            headers=req_headers,
            catch_response=True,
        ) as resp:
            if resp.status_code in (401, 429):
                resp.success()
