[project]
name = "fastapi-qa-blueprint"
version = "0.2.0"
description = "Plantilla base para APIs en FastAPI con auditoría profunda, mocking, profiling y BDD"
requires-python = ">=3.13"
dependencies = [
    "fastapi>=0.110.0",
    "uvicorn[standard]>=0.27.0",
    "python-dotenv>=1.0.0",
    "httpx>=0.27.0",
    "pydantic>=2.7.0",
    "pydantic-settings>=2.2.1",
    "sqlalchemy>=2.0.28",
    "alembic>=1.13.1",
    "asyncpg>=0.29.0",
    "redis>=5.0.3",
    "orjson>=3.10.0",
    "cryptography>=42.0.5",
    # Observabilidad & Métricas en runtime (obligatorias en producción con --no-dev)
    "prometheus-fastapi-instrumentator>=7.0.0",
    "prometheus-client>=0.20.0"
]

[project.optional-dependencies]
dev = [
    # Core Testing & Coverage
    "pytest>=8.0.0",
    "pytest-asyncio>=0.23.5",
    "pytest-cov>=4.1.0",
    "pytest-mock>=3.14.0",
    
    # Linting & Typing
    "ruff>=0.3.0",
    "mypy>=1.9.0",
    
    # QA Automation Matrices
    "tox>=4.14.0",
    "tox-uv>=1.16.0",
    
    # Security, Vulnerability & Mutation
    "bandit>=1.7.8",
    "pip-audit>=2.7.3",
    "mutmut>=2.4.5,<3.0.0",
    
    # Complexity & Profiling (Herramientas 11X)
    "radon>=6.0.1",
    "py-spy>=0.3.14",
    
    # Contracts & Load Testing
    "schemathesis>=3.25.0",
    "locust>=2.24.0"
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
python_files = ["*.unit.py", "*.spec.py", "test_*.py"]
pythonpath = ["."]
addopts = "--import-mode=importlib --strict-markers --cov=src/ --cov-report=html --cov-report=term-missing"
markers = [
    "integration: Pruebas internas que requieren conexión a internet o bases de datos (deseleccionar con '-m \"not integration\"')",
]

[tool.ruff]
line-length = 120
target-version = "py313"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B"]
ignore = ["B008", "E501"]

[tool.mypy]
strict = true
plugins = ["pydantic.mypy"]

[tool.mutmut]
paths_to_mutate = "src/"
backup = false
runner = "python -m pytest -x"
tests_dir = "tests/"

[tool.pyrefly]
search-path = ["."]
python-version = "3.13"

[tool.pyrefly.errors]
missing-import = false
missing-module-attribute = false
