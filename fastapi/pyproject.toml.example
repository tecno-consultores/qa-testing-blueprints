[project]
name = "fastapi-qa-blueprint"
version = "3.11.0"
description = "Plantilla base para APIs en FastAPI con auditoría profunda, mocking, profiling y BDD"
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.110.0",
    "uvicorn[standard]>=0.27.0",
    "python-dotenv>=1.0.0",
    "httpx>=0.27.0",
    "pydantic>=2.7.0",
    "pydantic-settings>=2.2.1",
    "sqlalchemy>=2.0.28",
    "alembic>=1.13.1",
    "asyncpg>=0.29.0",
    "redis>=5.0.3",
    "orjson>=3.10.0",
    "cryptography>=42.0.5",
    # Observabilidad & Métricas en runtime (obligatorias en producción con --no-dev)
    "prometheus-fastapi-instrumentator>=7.0.0",
    "prometheus-client>=0.20.0"
]

[project.optional-dependencies]
dev = [
    # Core Testing & Coverage
    "pytest>=8.0.0",
    "pytest-asyncio>=0.23.5",
    "pytest-cov>=4.1.0",
    "pytest-mock>=3.14.0",
    
    # Linting & Typing
    "ruff>=0.3.0",
    "mypy>=1.9.0",
    
    # QA Automation Matrices
    "tox>=4.14.0",
    "tox-uv>=1.16.0",
    
    # Security, Vulnerability & Mutation
    "bandit[toml]>=1.7.8",
    "pip-audit>=2.7.3",
    "cyclonedx-bom>=4.0.0",
    "mutmut>=3.8.1",
    
    # Complexity & Profiling (Herramientas 11X)
    "radon>=6.0.1",
    "py-spy>=0.3.14",
    "memray>=1.12.0; sys_platform == 'linux'",
    
    # Contracts, HTTP Mocking & Load Testing
    "pact-python>=3.0.0",
    "respx>=0.21.1",
    "schemathesis>=3.25.0",
    "locust>=2.24.0"
]

[tool.bandit]
targets = ["src"]
exclude_dirs = ["tests", ".venv", "venv"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
testpaths = ["tests"]
python_files = ["*.unit.py", "*.spec.py", "*.int.py", "test_*.py"]
pythonpath = ["src"]
addopts = "--import-mode=importlib --strict-markers --cov=src --cov-fail-under=95 --cov-report=html:/tmp/htmlcov --cov-report=term-missing"
markers = [
    "integration: Pruebas internas que requieren conexión a internet o bases de datos (deseleccionar con '-m \"not integration\"')",
]

[tool.ruff]
line-length = 88
target-version = "py312"
src = ["src"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "C901", "PLR0911", "PLR0913"]
ignore = ["B008", "E501"]

[tool.ruff.lint.mccabe]
max-complexity = 5

[tool.ruff.lint.pylint]
max-args = 4
max-returns = 4

[tool.ruff.lint.per-file-ignores]
"src/**/api/**/*.py" = ["PLR0913"]
"src/**/routers/**/*.py" = ["PLR0913"]
"tests/**/*.py" = ["PLR0913"]

[tool.mypy]
strict = true
mypy_path = "src"
plugins = ["pydantic.mypy"]

[tool.mutmut]
# mutmut 3.x requiere pythonpath = ["src"] e imports relativos a src/ (ej. from main import ..., nunca from src.main)
source_paths = ["src/"]
pytest_add_cli_args = ["-x", "--no-cov", "-m", "not integration", "--ignore=tests/contracts"]
pytest_add_cli_args_test_selection = ["tests/"]
