# OWASP ZAP Automation Framework (Rule Zero / contenedor no-root, /zap/wrk:ro -> salida en /reports)

env:
  contexts:
    - name: "fastapi-qa-target"
      urls:
        - "http://api:8000"
      includePaths:
        - "http://api:8000/.*"
      excludePaths:
        - "http://api:8000/docs.*"
        - "http://api:8000/redoc.*"
        - "http://api:8000/openapi\\.json"
  parameters:
    failOnError: true
    failOnWarning: false
    progressToStdout: true

jobs:
  - type: passiveScan-config
    parameters:
      maxAlertsPerRule: 10
      scanOnlyInScope: true
  - type: alertFilter
    alertFilters: []
  - type: requestor
    requests:
      - url: "http://api:8000/health"
        name: "healthcheck"
        method: "GET"
        responseCode: 200
  - type: passiveScan-wait
    parameters:
      maxDuration: 5
  - type: activeScan
    parameters:
      context: "fastapi-qa-target"
      policy: "API-minimal"
      maxRuleDurationInMins: 2
      maxScanDurationInMins: 5
  - type: report
    parameters:
      template: "traditional-html"
      reportDir: "/reports"
      reportFile: "zap-report.html"
      reportTitle: "QA-11X FastAPI OWASP ZAP DAST Report"
    risks:
      - high
      - medium
      - low
      - info
  - type: report
    parameters:
      template: "traditional-json"
      reportDir: "/reports"
      reportFile: "zap-report.json"
  - type: outputSummary
    parameters:
      format: "Long"
      summaryFile: "/reports/zap-summary.json"
