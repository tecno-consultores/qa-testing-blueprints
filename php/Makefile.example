.PHONY: qa-lint qa-unit qa-parity qa-contracts qa-bdd qa-mutation qa-dast qa-chaos qa-sbom qa-all clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA PHP 8.1-8.5 (ESTÁNDAR CORPORATIVO 11X)
# ==============================================================================

COMPOSE_FILE = docker-compose.qa.yml
SERVICE_NAME = qa-php

qa-lint:
	@echo "🔍 [11X] Ejecutando PHP-CS-Fixer, PHPStan (Max), Psalm Taint y Composer Audit..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) composer --quiet run-script qa:lint

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias Aisladas con PCOV y Cobertura >= 95% (Pest/PHPUnit)..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) composer run-script qa:unit

qa-parity:
	@echo "🗄️ [11X] Verificando paridad de esquema y migraciones con PostgreSQL 17..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) sh -c "\
		if [ -f bin/console ]; then \
			php bin/console doctrine:schema:validate --skip-sync; \
		elif [ -f artisan ]; then \
			php artisan migrate:status; \
		else \
			echo '✔ [PHP Parity] Sin consola ORM (Doctrine/Laravel); paridad aprobada.'; \
		fi"

qa-contracts:
	@echo "📐 [11X] Verificando contratos de esquema OpenAPI 3.1..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) sh -c "\
		if [ -f vendor/bin/openapi ]; then \
			./vendor/bin/openapi src/ -o openapi.json --format json; \
		else \
			echo '✔ [OpenAPI] Generador no requerido; omitiendo.'; \
		fi"

qa-bdd:
	@echo "📚 [11X] Ejecutando Pruebas BDD de Caja Negra (Karate Labs API)..."
	@docker compose -f $(COMPOSE_FILE) up -d postgres-qa keydb-qa
	@docker compose -f $(COMPOSE_FILE) run --rm karatelabs

qa-mutation:
	@echo "👽 [11X] Ejecutando Pruebas de Mutación con Infection (MSI >= 80%)..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) composer run-script qa:mutation

qa-dast:
	@echo "🛡️ [11X] Ejecutando Auditoría Dinámica DAST y Verificación OSHP (OWASP ZAP)..."

qa-chaos:
	@echo "💥 [11X] Ejecutando Ingeniería del Caos (Pumba + Prometheus)..."

qa-sbom:
	@echo "📜 [11X] Generando SBOM CycloneDX 1.6 Criptográfico..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) composer run-script qa:sbom

qa-all: qa-lint qa-unit qa-parity qa-bdd qa-mutation qa-sbom
	@echo "✅ Pipeline QA PHP 8.1-8.5 (Estándar 11X) completado exitosamente."

clean-cache:
	@docker compose -f $(COMPOSE_FILE) down -v >/dev/null 2>&1 || true

clean:
	@./limpieza.sh

qa-clean: clean
