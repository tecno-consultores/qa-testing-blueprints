.PHONY: qa-lint qa-unit qa-parity qa-contracts qa-bdd qa-mutation qa-dast qa-load qa-chaos qa-observability qa-sbom qa-all clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA PHP 8.2-8.5 (ESTÁNDAR CORPORATIVO 11X)
# ==============================================================================

COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-php
PROJECT_DIR ?= $(CURDIR)
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
export QA_UID QA_GID
# Para sobrescribir la imagen PHP por defecto, exporta PHP_IMAGE con digest SHA-256 fijado (sin tags mutables).

qa-lint:
	@echo "🔍 [11X] Ejecutando PHP-CS-Fixer, PHPStan (Max), Psalm Taint y Composer Audit..."
	@[ ! -x ./scripts/verificar-secretos.sh ] || ./scripts/verificar-secretos.sh
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) sh -c '([ -f vendor/autoload.php ] || php -d allow_url_fopen=1 "$$(command -v composer)" install --no-interaction --prefer-dist --quiet) && php -d allow_url_fopen=1 "$$(command -v composer)" run-script qa:lint'

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias Aisladas con PCOV y Cobertura >= 95% (Pest/PHPUnit)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) sh -c '([ -f vendor/autoload.php ] || php -d allow_url_fopen=1 "$$(command -v composer)" install --no-interaction --prefer-dist --quiet) && php -d allow_url_fopen=1 "$$(command -v composer)" run-script qa:unit'

qa-parity:
	@echo "🗄️ [11X] Verificando paridad de esquema, migraciones y FORCE RLS en PostgreSQL 17..."
	@bash -c 'set -euo pipefail; trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile \"*\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile integration up -d --wait --wait-timeout 60 postgres-qa keydb-qa && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) sh -c "\
			([ -f vendor/autoload.php ] || php -d allow_url_fopen=1 \"\$$(command -v composer)\" install --no-interaction --prefer-dist --quiet) && \
			if [ -f bin/console ]; then \
				DATABASE_URL=\"\$$MIGRATION_DATABASE_URL\" php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration && \
				DATABASE_URL=\"\$$MIGRATION_DATABASE_URL\" php bin/console doctrine:schema:validate; \
			elif [ -f artisan ]; then \
				DB_URL=\"\$$MIGRATION_DATABASE_URL\" php artisan migrate --force --no-interaction && \
				DB_URL=\"\$$MIGRATION_DATABASE_URL\" php artisan migrate:status; \
			else \
				echo \"[SKIPPED] Sin consola ORM (Doctrine/Laravel); migración omitida.\"; \
			fi" && \
		unprotected=$$(docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile integration exec -T postgres-qa psql -U qa_user -d qa_db -tAc "SELECT COUNT(*) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = '\''public'\'' AND c.relkind = '\''r'\'' AND c.relname NOT IN ('\''doctrine_migration_versions'\'', '\''migrations'\'') AND (NOT c.relrowsecurity OR NOT c.relforcerowsecurity);"); \
		unprotected="$${unprotected//[[:space:]]/}"; \
		if ! [[ "$${unprotected}" =~ ^[0-9]+$$ ]]; then echo "❌ [RLS] Consulta RLS inválida: '\''$${unprotected}'\''" >&2; exit 1; fi; \
		if [ "$${unprotected}" -gt 0 ]; then echo "❌ [RLS] $${unprotected} tablas sin FORCE ROW LEVEL SECURITY." >&2; exit 1; fi'

qa-contracts:
	@echo "📐 [11X] Verificando contratos de esquema OpenAPI 3.1..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) sh -c "\
		([ -f vendor/autoload.php ] || php -d allow_url_fopen=1 \"\$$(command -v composer)\" install --no-interaction --prefer-dist --quiet) && \
		if [ -f vendor/bin/openapi ]; then \
			./vendor/bin/openapi src/ -o openapi.json --format json; \
		else \
			echo '[SKIPPED] Generador OpenAPI no instalado; omitiendo.'; \
		fi"

qa-bdd:
	@echo "📚 [11X] Ejecutando Pruebas BDD de Caja Negra (Karate Labs API)..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile \"*\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile integration up -d --wait --wait-timeout 60 postgres-qa keydb-qa php-api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile integration run --rm -T karatelabs mvn -B clean test'

qa-mutation:
	@echo "👽 [11X] Ejecutando Pruebas de Mutación con Infection (MSI >= 80%)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) sh -c '([ -f vendor/autoload.php ] || php -d allow_url_fopen=1 "$$(command -v composer)" install --no-interaction --prefer-dist --quiet) && php -d allow_url_fopen=1 "$$(command -v composer)" run-script qa:mutation'

qa-dast:
	@echo "🛡️ [11X] Ejecutando Auditoría Dinámica DAST y Verificación OSHP (OWASP ZAP)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile \"*\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile integration up -d --wait --wait-timeout 60 postgres-qa keydb-qa php-api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile integration run --rm -T -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp -e _JAVA_OPTIONS="-Duser.home=/tmp" zap sh -c "if [ -f /zap/wrk/zap.yaml ]; then zap.sh -dir /tmp/.ZAP -cmd -autorun /zap/wrk/zap.yaml; else zap.sh -dir /tmp/.ZAP -cmd -quickurl http://php-api:8000 -quickout /reports/zap-report.html; fi"'

qa-load:
	@echo "⚡ [11X] Ejecutando Pruebas de Carga y SLOs (k6)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile \"*\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile load up -d --wait --wait-timeout 60 postgres-qa keydb-qa php-api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile load run --rm -T -u "$(QA_UID):$(QA_GID)" k6-smoke'

qa-chaos:
	@echo "💥 [11X] Ejecutando Ingeniería del Caos (Pumba + Prometheus + k6)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile \"*\" down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile chaos up -d --wait --wait-timeout 60 postgres-qa keydb-qa php-api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile chaos up -d pumba prometheus && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile load run --rm -T -e K6_P95_MS=900 -e K6_P99_MS=1500 k6-smoke'

qa-observability:
	@echo "📈 [11X] Levantando observabilidad (Prometheus)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile observability up -d --wait --wait-timeout 60 prometheus

qa-sbom:
	@echo "📜 [11X] Generando SBOM CycloneDX 1.6 Criptográfico..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) sh -c '([ -f vendor/autoload.php ] || php -d allow_url_fopen=1 "$$(command -v composer)" install --no-interaction --prefer-dist --quiet) && php -d allow_url_fopen=1 "$$(command -v composer)" run-script qa:sbom && ([ ! -f sbom-php.cdx.json ] || mv sbom-php.cdx.json reports/sbom-php.cdx.json)'

qa-all: qa-lint qa-unit qa-parity qa-bdd qa-mutation qa-sbom
	@echo "✅ Pipeline QA PHP 8.2-8.5 (Estándar 11X) completado exitosamente."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
