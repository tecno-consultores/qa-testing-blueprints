.PHONY: qa-lint qa-unit qa-offline qa-ci audit-llm qa-all clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA AI-EVALS 11X (sinfallas/base-python-uv:3.15 + base-node-ionic:26)
# ==============================================================================

COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-evals
PROMPTFOO_SERVICE ?= qa-promptfoo
PROJECT_DIR ?= $(CURDIR)
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
export QA_UID QA_GID

qa-lint:
	@echo "🔍 [11X] Verificando Ruff (CC <= 5) y Mypy --strict en AI-Evals..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) sh -c "\
		ruff check --select E,F,W,I,UP,B,C901 --config \"lint.mccabe.max-complexity=5\" --config \"src=[]\" . && \
		mypy --strict --cache-dir=/tmp/mypy _llm_judge.py golden_from_traces.py rag/test_rag_faithfulness.py voice-realtime/test_voice_websocket_latency.py multimodal-ocr/test_pdf_table_fidelity.py tests/test_golden_from_traces.py"

qa-unit:
	@echo "🧪 [11X] Ejecutando Contratos Offline RAG/Voz/OCR/Golden y Cobertura >= 95% (Pytest + DeepEval)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) sh -c "\
		pytest -o cache_dir=/tmp/pytest-cache -o asyncio_default_fixture_loop_scope=function \
		-W \"ignore::DeprecationWarning:deepeval.*\" -W \"ignore:.*HallucinationMetric.*:DeprecationWarning\" \
		-W \"ignore::SyntaxWarning:deepeval.*\" --import-mode=importlib \
		--cov=. --cov-fail-under=95 --cov-report=term-missing \
		rag/test_rag_faithfulness.py voice-realtime/test_voice_websocket_latency.py multimodal-ocr/test_pdf_table_fidelity.py tests/test_golden_from_traces.py"

qa-offline: qa-unit

qa-ci: qa-lint qa-unit
	@echo "✅ [11X] Suite Offline AI-Evals (lint + contratos >= 95%) certificada."

audit-llm:
	@if [ -z "$${OPENAI_API_KEY:-}$${GEMINI_API_KEY:-}$${ANTHROPIC_API_KEY:-}$${OLLAMA_BASE_URL:-}$${OPENAI_API_BASE:-}" ]; then \
		echo "⚠️ [SKIPPED/MISSING_LLM_CREDENTIALS] Sin proveedor LLM configurado (exporte OPENAI_API_KEY, GEMINI_API_KEY, ANTHROPIC_API_KEY, OLLAMA_BASE_URL u OPENAI_API_BASE)." >&2; \
		exit 2; \
	fi
	@echo "🤖 [11X] Ejecutando evaluación probabilística DeepEval (Modo 2)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" \
		-e QA_LLM_AUDIT_LIVE="$${QA_LLM_AUDIT_LIVE:-$${RUN_LLM_AUDIT:-1}}" \
		-e RUN_LLM_AUDIT="$${RUN_LLM_AUDIT:-1}" \
		-e OPENAI_API_KEY -e GEMINI_API_KEY -e ANTHROPIC_API_KEY -e OLLAMA_BASE_URL -e OPENAI_API_BASE -e QA_LLM_MODEL \
		$(SERVICE_NAME) pytest -o cache_dir=/tmp/pytest-cache -o asyncio_default_fixture_loop_scope=function \
		--import-mode=importlib rag/test_rag_faithfulness.py voice-realtime/test_voice_websocket_latency.py multimodal-ocr/test_pdf_table_fidelity.py -k "live"
	@echo "🛡️ [11X] Ejecutando matriz multi-modelo y Red Team OWASP LLM Top 10 (Promptfoo)..."
	@bash -c 'set -euo pipefail; \
		pf_patterns=(); judge="$${PROMPTFOO_JUDGE_PROVIDER:-}"; \
		if [ -n "$${OPENAI_API_KEY:-}" ] || [ -n "$${OPENAI_API_BASE:-}" ]; then pf_patterns+=("^openai:"); judge="$${judge:-openai:gpt-4.1-mini}"; fi; \
		if [ -n "$${ANTHROPIC_API_KEY:-}" ]; then pf_patterns+=("^anthropic:"); judge="$${judge:-anthropic:messages:claude-sonnet-4-5}"; fi; \
		if [ -n "$${GEMINI_API_KEY:-}" ]; then pf_patterns+=("^google:"); judge="$${judge:-google:gemini-2.5-flash}"; fi; \
		if [ -n "$${OLLAMA_BASE_URL:-}" ]; then pf_patterns+=("^ollama:"); judge="$${judge:-ollama:chat:qwen3:8b}"; fi; \
		pf_regex="$$(IFS="|"; echo "$${pf_patterns[*]}")"; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile llm-live run --rm -T -u "$(QA_UID):$(QA_GID)" \
			-e PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=1 \
			-e OPENAI_API_KEY -e GEMINI_API_KEY -e ANTHROPIC_API_KEY -e OLLAMA_BASE_URL -e OPENAI_API_BASE \
			-e PROMPTFOO_JUDGE_PROVIDER="$${judge}" \
			$(PROMPTFOO_SERVICE) promptfoo eval -c promptfooconfig.yaml --filter-providers "$${pf_regex}" --no-cache -o /tmp/promptfoo-results.json'

qa-all: qa-lint qa-unit
	@echo "✅ [11X] Pipeline QA AI-Evals Offline completado."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true

clean: clean-cache
	@if [ -x ./limpieza.sh ]; then ./limpieza.sh; else docker run --rm --network none alpine:3.21@sha256:bc21487101ae47172509130ee1092cc273a831968d64b617776d1f69c81e42ab true; fi

qa-clean: clean
