.PHONY: qa-lint qa-audit qa-audit-enforce qa-unit qa-ci qa-all clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA VIBE-RESCUE 11X (sinfallas/base-python-uv:3.15)
# ==============================================================================

COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-vibe-rescue
PROJECT_DIR ?= $(CURDIR)
TARGET_DIR ?= /app
export QA_UID := $(shell id -u)
export QA_GID := $(shell id -g)

qa-lint:
	@echo "🔍 [11X] Verificando Ruff (CC <= 5) y Mypy --strict en Vibe-Rescue..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T $(SERVICE_NAME) sh -c "\
		ruff check --select E,F,W,I,UP,B,C901 --config \"lint.mccabe.max-complexity=5\" . && \
		mypy --strict --cache-dir=/tmp/mypy audit_vibe_prototype.py"

qa-audit:
	@echo "🛡️ [11X] Ejecutando auditoría Vibe-to-Enterprise en modo dry-run..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T $(SERVICE_NAME) python3 audit_vibe_prototype.py --target "$(TARGET_DIR)" --json

qa-audit-enforce:
	@echo "🚨 [11X] Ejecutando auditoría bloqueante Vibe-to-Enterprise (--enforce)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T $(SERVICE_NAME) python3 audit_vibe_prototype.py --target "$(TARGET_DIR)" --enforce

qa-unit:
	@echo "🧪 [11X] Ejecutando pruebas unitarias (>= 95% cobertura) en contenedor efímero..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T $(SERVICE_NAME) sh -c "\
		if [ -d tests ] && find tests -type f \( -name 'test_*.py' -o -name '*_test.py' \) | grep -q .; then \
			pytest -q --tb=short --import-mode=importlib -o cache_dir=/tmp/pytest-cache --cov=. --cov-fail-under=95 --cov-report=term-missing; \
		else \
			echo '⚠️ [SKIPPED/NO_TESTS_DIR] Sin suite pytest en tests/; agregue pruebas en tests/ para habilitar --cov-fail-under=95.' >&2; \
			exit 2; \
		fi"

qa-ci: qa-lint qa-audit
	@echo "✅ [11X] Paridad lint + auditoría dry-run Vibe-Rescue completada."

qa-all: qa-lint qa-audit qa-unit
	@echo "✅ [11X] Pipeline QA Vibe-Rescue completado."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true

clean: clean-cache
	@if [ -x ./limpieza.sh ]; then ./limpieza.sh; else docker run --rm --network none alpine:3.21@sha256:bc21487101ae47172509130ee1092cc273a831968d64b617776d1f69c81e42ab true; fi

qa-clean: clean
