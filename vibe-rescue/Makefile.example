.PHONY: qa-lint qa-audit qa-audit-enforce qa-unit qa-ci certify qa-all clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA VIBE-RESCUE 11X (sinfallas/base-python-uv:3.15)
# ==============================================================================

COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-vibe-rescue
PROJECT_DIR ?= $(CURDIR)
TARGET_DIR ?= /app
PYTHON_QA_IMAGE ?= sinfallas/base-python-uv:3.15@sha256:b5323179c6278cef2775d870fdfb4628f19ec2567430de8774889867961018c4
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
export QA_UID QA_GID

qa-lint:
	@echo "🔍 [11X] Verificando Ruff (CC <= 5) y Mypy --strict en Vibe-Rescue..."
	@docker run --rm --network none --restart=no --security-opt=no-new-privileges:true -u "$(QA_UID):$(QA_GID)" \
		-e HOME=/tmp -e PYTHONDONTWRITEBYTECODE=1 -e COVERAGE_FILE=/tmp/.coverage -e RUFF_CACHE_DIR=/tmp/ruff-cache -e DEEPEVAL_TELEMETRY_OPT_OUT=YES -e PYTHONPATH=/app \
		-v "$(PROJECT_DIR):/app:ro" -w /app $(PYTHON_QA_IMAGE) sh -c "\
		ruff check --select E,F,W,I,UP,B,C901,FLY,PLR0913 --config \"lint.mccabe.max-complexity=5\" --config \"lint.pylint.max-args=4\" . && \
		mypy --strict --cache-dir=/tmp/mypy _vibe_rules.py audit_vibe_prototype.py tests/test_audit_vibe_prototype.unit.py"

qa-audit:
	@echo "🛡️ [11X] Ejecutando auditoría Vibe-to-Enterprise en modo dry-run..."
	@docker run --rm --network none --restart=no --security-opt=no-new-privileges:true -u "$(QA_UID):$(QA_GID)" \
		-e HOME=/tmp -e PYTHONDONTWRITEBYTECODE=1 -e COVERAGE_FILE=/tmp/.coverage -e DEEPEVAL_TELEMETRY_OPT_OUT=YES -e PYTHONPATH=/app \
		-v "$(PROJECT_DIR):/app:ro" -w /app $(PYTHON_QA_IMAGE) python3 audit_vibe_prototype.py --target "$(TARGET_DIR)" --json

qa-audit-enforce:
	@echo "🚨 [11X] Ejecutando auditoría bloqueante Vibe-to-Enterprise (--enforce)..."
	@docker run --rm --network none --restart=no --security-opt=no-new-privileges:true -u "$(QA_UID):$(QA_GID)" \
		-e HOME=/tmp -e PYTHONDONTWRITEBYTECODE=1 -e COVERAGE_FILE=/tmp/.coverage -e DEEPEVAL_TELEMETRY_OPT_OUT=YES -e PYTHONPATH=/app \
		-v "$(PROJECT_DIR):/app:ro" -w /app $(PYTHON_QA_IMAGE) python3 audit_vibe_prototype.py --target "$(TARGET_DIR)" --enforce

qa-unit:
	@echo "🧪 [11X] Ejecutando pruebas unitarias (>= 95% cobertura) en contenedor efímero..."
	@docker run --rm --network none --restart=no --security-opt=no-new-privileges:true -u "$(QA_UID):$(QA_GID)" \
		-e HOME=/tmp -e PYTHONDONTWRITEBYTECODE=1 -e COVERAGE_FILE=/tmp/.coverage -e UV_CACHE_DIR=/tmp/uv-cache -e DEEPEVAL_TELEMETRY_OPT_OUT=YES -e PYTHONPATH=/app \
		-v "$(PROJECT_DIR):/app:rw" -w /app $(PYTHON_QA_IMAGE) sh -c "\
		if [ -d tests ] && find tests -type f \( -name 'test_*.py' -o -name '*_test.py' -o -name '*.unit.py' -o -name '*.spec.py' \) | grep -q .; then \
			pytest -q --tb=short --import-mode=importlib -o asyncio_default_fixture_loop_scope=function -W \"ignore::DeprecationWarning\" -W \"ignore::SyntaxWarning\" -o \"python_files=test_*.py *_test.py *.unit.py *.spec.py\" -o cache_dir=/tmp/pytest-cache --cov=. --cov-branch --cov-fail-under=95 --cov-report=term-missing --cov-report=xml:coverage.xml; \
		else \
			echo '⚠️ [SKIPPED/NO_TESTS_DIR] Sin suite pytest en tests/; agregue pruebas en tests/ para habilitar --cov-fail-under=95.' >&2; \
			exit 2; \
		fi"

qa-ci: qa-lint qa-audit-enforce qa-unit
	@echo "✅ [11X] Paridad lint + auditoría bloqueante + unit Vibe-Rescue completada."

certify:
	@[ -x ./.agents/scripts/certify_task_completion.sh ] && ./.agents/scripts/certify_task_completion.sh || echo "⚠️ [SKIPPED] certify_task_completion.sh no instalado."

qa-all: qa-lint qa-audit qa-unit
	@echo "✅ [11X] Pipeline QA Vibe-Rescue completado."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true

clean: clean-cache
	@if [ -x ./limpieza.sh ]; then ./limpieza.sh; else docker run --rm --network none --restart=no --security-opt=no-new-privileges:true alpine:3.21@sha256:bc21487101ae47172509130ee1092cc273a831968d64b617776d1f69c81e42ab true; fi

qa-clean: clean
