{
  "name": "vue3-qa-blueprint",
  "version": "2.9.0",
  "type": "module",
  "description": "Plantilla base para Frontend Vue 3 corporativo (Linting, Stryker, Lighthouse, Playwright y Vitest)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,vue}\" \"tests/**/*.{js,ts}\" \"e2e/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue}\" \"tests/**/*.{js,ts}\" \"e2e/**/*.{js,ts}\"",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "audit:deps": "pnpm audit --prod",
    "test:e2e": "playwright test",
    "test:perf": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "dompurify": "^3.1.0",
    "pinia": "^2.2.2",
    "vue": "^3.5.13",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "1.52.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.12"
  }
}
