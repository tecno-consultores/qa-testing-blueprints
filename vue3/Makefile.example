.PHONY: qa-lint qa-unit qa-orphans qa-mutation qa-perf qa-e2e qa-bdd qa-psi qa-obs qa-all build-ui clean-cache clean qa-clean

# ==============================================================================
# MAKEFILE QA VUE 3 (ESTÁNDAR CORPORATIVO 11X)
# ==============================================================================

COMPOSE_FILE = docker-compose.qa.yml
SERVICE_NAME = qa-vue3
E2E_SERVICE = ui-e2e
export QA_UID := $(shell id -u)
export QA_GID := $(shell id -g)

build-ui:
	@echo "🏗️ Compilando la aplicación (Vue/Vite) para entorno E2E/Producción..."
	@docker compose -f $(COMPOSE_FILE) run --rm -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "pnpm install --silent && pnpm --silent run build"
	@docker compose -f $(COMPOSE_FILE) up -d ui-prod

qa-lint:
	@echo "🔍 [11X] Ejecutando Auditoría de CVEs, Linter, Types y Formateo (Vue/TS)..."
	@docker compose -f $(COMPOSE_FILE) run --rm -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "pnpm install --silent && pnpm run audit:deps && pnpm run type-check && pnpm run format:check && pnpm lint"

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias Aisladas (Vitest >= 95%)..."
	@docker compose -f $(COMPOSE_FILE) run --rm -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "pnpm install --silent && pnpm run test:coverage"

qa-orphans:
	@echo "🧩 [11X] Verificando cero componentes UI huérfanos en Docker (Rule Zero)..."
	@docker compose -f $(COMPOSE_FILE) run --rm -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "\
		if [ -f .agents/scripts/verify_zero_orphan_vue_components.py ]; then \
			python3 .agents/scripts/verify_zero_orphan_vue_components.py; \
		else \
			node -e \"const fs=require('fs'),p=require('path');const walk=d=>fs.existsSync(d)?fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(d,e.name)):[p.join(d,e.name)]):[];const tests=walk('src').concat(walk('tests')).filter(f=>/\.(unit|spec|test)\.(ts|tsx|js|jsx)$$|\.(test)\.vue$$/.test(f));const comps=walk('src/components').concat(walk('src/views')).filter(f=>f.endsWith('.vue'));const m=comps.filter(c=>{const b=p.basename(c,'.vue');return !tests.some(t=>p.basename(t).startsWith(b+'.'));});if(m.length){console.error('Componentes huerfanos:',m);process.exit(1)}\"; \
		fi"

qa-mutation:
	@echo "👽 [11X] Ejecutando Pruebas de Mutación Frontend (Stryker)..."
	@docker compose -f $(COMPOSE_FILE) run --rm -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "pnpm install --silent && pnpm run mutate"

qa-perf: build-ui
	@echo "⚡ [11X] Ejecutando Auditoría de Rendimiento (Lighthouse CI)..."
	@docker compose -f $(COMPOSE_FILE) run --rm -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp $(E2E_SERVICE) bash -c "export CHROME_PATH=\$$(ls -d /ms-playwright/chromium-*/chrome-linux/chrome 2>/dev/null | head -n 1) && if [ -x ./node_modules/.bin/lhci ]; then ./node_modules/.bin/lhci autorun --config=lighthouserc.cjs; elif command -v pnpm >/dev/null 2>&1; then pnpm install --silent && pnpm run test:perf; else corepack pnpm install --silent && corepack pnpm run test:perf; fi"

qa-e2e: build-ui
	@echo "🎭 [11X] Ejecutando Regresión Visual y Accesibilidad WCAG 2.1 AA (Playwright + Axe)..."
	@docker compose -f $(COMPOSE_FILE) run --rm -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp $(E2E_SERVICE) bash -c "if [ -x ./node_modules/.bin/playwright ]; then ./node_modules/.bin/playwright test; elif command -v pnpm >/dev/null 2>&1; then pnpm install --silent && pnpm exec playwright test; else corepack pnpm install --silent && corepack pnpm exec playwright test; fi"

qa-bdd: build-ui
	@echo "📚 [11X] Ejecutando Pruebas de Aceptación BDD (Karate Contratos HTTP/OSHP/SSG sobre Nginx)..."
	@docker compose -f $(COMPOSE_FILE) run --rm karatelabs mvn -B clean test

qa-psi:
	@echo "🌐 [11X] Ejecutando Auditoría Post-Deploy en Google PageSpeed Insights (Modo Dual)..."
	@docker compose -f $(COMPOSE_FILE) run --rm -u "$(QA_UID):$(QA_GID)" -e HOME=/tmp -e PAGESPEED_API_KEY -e PSI_URL="$${PSI_URL:-$(URL)}" $(SERVICE_NAME) python3 .agents/scripts/audit_pagespeed_insights.py

qa-obs: build-ui
	@echo "📊 Levantando Stack de Observabilidad Frontend..."
	@docker compose -f $(COMPOSE_FILE) --profile observability up -d prometheus nginx-exporter

qa-all: qa-lint qa-orphans qa-unit qa-mutation qa-perf qa-e2e qa-bdd
	@echo "✅ Pipeline QA Frontend (Vue 3 11X) completado exitosamente."

clean-cache:
	@docker compose -f $(COMPOSE_FILE) down -v >/dev/null 2>&1 || true
	@docker compose -f $(COMPOSE_FILE) --profile observability down -v >/dev/null 2>&1 || true

clean:
	@./limpieza.sh

qa-clean: clean
