.PHONY: qa-lint qa-unit qa-observability qa-all clean-cache clean qa-clean

# Variables
COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-bash
PROJECT_DIR ?= $(CURDIR)
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
BATS_TARGETS ?=
KCOV_PARSE_DIR ?= .
KCOV_INCLUDE_PATH ?= .
KCOV_EXCLUDE_EXTRA ?=
export QA_UID QA_GID

qa-lint:
	@echo "🔍 Ejecutando Linter y Formateo (ShellCheck + shfmt)..."
	@[ ! -x ./scripts/verificar-secretos.sh ] || ./scripts/verificar-secretos.sh
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "mapfile -d '' files < <(find . \( -name node_modules -o -name .venv -o -name vendor -o -name .bats-battery \) -prune -o -type f -name '*.sh' -print0); if [ \$${#files[@]} -gt 0 ]; then shellcheck -x \"\$${files[@]}\" && shfmt -i 2 -ci -d \"\$${files[@]}\"; fi"

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias y Cobertura >= 95% (BATS + kcov rootless)..."
	@mkdir -p .agents/.cache/coverage
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e _USER=qa -e QA_BATS_TARGETS="$(BATS_TARGETS)" -e QA_KCOV_PARSE_DIR="$(KCOV_PARSE_DIR)" -e QA_KCOV_INCLUDE_PATH="$(KCOV_INCLUDE_PATH)" -e QA_KCOV_EXCLUDE_EXTRA="$(KCOV_EXCLUDE_EXTRA)" $(SERVICE_NAME) bash -c 'set -euo pipefail; kcov_tmp="$${QA_KCOV_TMP:-/tmp}"; kcov_out="$${QA_KCOV_OUT:-/tmp/kcov-out}"; parse_dir="$$(cd "$${QA_KCOV_PARSE_DIR:-.}" && pwd)"; include_dir="$$(cd "$${QA_KCOV_INCLUDE_PATH:-.}" && pwd)"; excl="$${parse_dir}/test,$${parse_dir}/tests,$${parse_dir}/.agents/,$${parse_dir}/.git/,$${parse_dir}/node_modules/,$${parse_dir}/.venv/,$${parse_dir}/vendor/,$${parse_dir}/.bats-battery/,$${parse_dir}/graphify-out/,$${parse_dir}/coverage_report/,$${parse_dir}/limpieza.sh,$${parse_dir}/scripts/limpieza.sh,$${parse_dir}/instalar-hooks.sh,$${parse_dir}/scripts/verificar-secretos.sh,$${parse_dir}/scripts/auditar-infra.sh,$${parse_dir}/scripts/auditar-pagespeed.sh,$${parse_dir}/scripts/actualizar-grafos-graphify.sh,$${parse_dir}/scripts/generar-sbom-cyclonedx.sh,$${parse_dir}/scripts/install-skill.sh$${QA_KCOV_EXCLUDE_EXTRA:+,$${QA_KCOV_EXCLUDE_EXTRA}}"; if [ -n "$${QA_BATS_TARGETS:-}" ]; then if [ -e "$${QA_BATS_TARGETS}" ]; then bats_targets=("$${QA_BATS_TARGETS}"); elif [[ "$${QA_BATS_TARGETS}" == *:* ]]; then IFS=: read -r -a bats_targets <<<"$${QA_BATS_TARGETS}"; else read -r -a bats_targets <<<"$${QA_BATS_TARGETS}"; fi; elif [ -d test ]; then bats_targets=(test); elif [ -d tests/bash ]; then bats_targets=(tests/bash); elif [ -d tests/bats ]; then bats_targets=(tests/bats); else echo "Error: directorio BATS no encontrado (test, tests/bash o tests/bats)." >&2; exit 1; fi; printf "%s\n" "if [[ \"\$${KCOV_BASH_XTRACEFD:-}\" =~ ^[0-9]+\$$ ]] && [ -p \"/proc/\$${BASHPID}/fd/\$${KCOV_BASH_XTRACEFD}\" ]; then" "  PS4='\''kcov@\$$""{BASH_SOURCE}@\$$""{LINENO}@'\''" "  BASH_XTRACEFD=\"\$${KCOV_BASH_XTRACEFD}\"" "  set -x" "fi" >"$${kcov_tmp}/kcov-env.sh"; printf "#!/usr/bin/env bash\nexport -n BASH_XTRACEFD 2>/dev/null || unset BASH_XTRACEFD\nexport BASH_ENV=\"%s/kcov-env.sh\"\nexec bats \"\$$@\"\n" "$${kcov_tmp}" >"$${kcov_tmp}/run-bats.sh"; chmod +x "$${kcov_tmp}/run-bats.sh"; rm -rf "$${kcov_out}" coverage_report; rc=0; env -u KCOV_BASH_XTRACEFD -u BASH_XTRACEFD -u BASH_ENV kcov --bash-dont-parse-binary-dir --bash-parse-files-in-dir="$${parse_dir}" --include-path="$${include_dir}" --exclude-pattern="$${excl}" -l 80,95 "$${kcov_out}" "$${kcov_tmp}/run-bats.sh" "$${bats_targets[@]}" >/tmp/bats-tap.log 2>/tmp/kcov-stderr.log || rc=$$?; cat /tmp/bats-tap.log; if [ "$${rc}" -ne 0 ]; then if ! grep -q "^not ok " /tmp/bats-tap.log 2>/dev/null; then tail -n 40 /tmp/kcov-stderr.log >&2; fi; exit "$${rc}"; fi; mkdir -p .agents/.cache/coverage && chmod 0700 .agents/.cache .agents/.cache/coverage; /usr/bin/python3 -c "import json, os, pathlib, re, sys; r = pathlib.Path(sys.argv[1]); out_xml = pathlib.Path(sys.argv[2]); jf = [p for p in sorted(r.rglob(\"coverage.json\")) if not p.parent.is_symlink()]; xf = [p for p in sorted(r.rglob(\"cobertura.xml\")) if not p.parent.is_symlink()]; mxf = [p for p in xf if p.parent.name == \"kcov-merged\"]; src_xml = (mxf[0] if mxf else xf[0]) if xf else None; src_xml is None and sys.exit(1); raw_xml = src_xml.read_text(encoding=\"utf-8\"); san = raw_xml if \"<!ENTITY\" in raw_xml.upper() else re.sub(r\"<!DOCTYPE\s+coverage\s+[^\s[\]<>][^[\]<>]*>\r?\n?\", \"\", raw_xml, flags=re.I); out_xml.write_text(san, encoding=\"utf-8\"); os.chmod(out_xml, 0o600); ds = [json.loads(p.read_text(encoding=\"utf-8\")) for p in jf if p.parent.name == \"kcov-merged\"] or [json.loads(p.read_text(encoding=\"utf-8\")) for p in jf]; tot = sum(int(d.get(\"total_lines\", 0)) for d in ds); cov = sum(int(d.get(\"covered_lines\", 0)) for d in ds); m_v = re.search(r\"<coverage[^>]*lines-valid=.(\d+)\", san); m_r = re.search(r\"<coverage[^>]*line-rate=.([0-9.]+)\", san); pct = ((cov * 100.0 / tot) if tot > 0 else 0.0) if ds else ((float(m_r.group(1)) * 100.0) if (m_r and m_v and int(m_v.group(1)) > 0) else 0.0); print(f\"Cobertura kcov: {pct:.2f}% (umbral >= 95.0%)\"); sys.exit(0 if pct >= 95.0 else 1)" "$${kcov_out}" ".agents/.cache/coverage/bash.xml"'

qa-observability:
	@echo "📈 [11X] Levantando observabilidad (Prometheus + Pushgateway)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile observability up -d prometheus pushgateway

qa-all: qa-lint qa-unit
	@echo "✅ Pipeline QA Bash completado."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true
	@rm -rf coverage_report/ 2>/dev/null || true

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
