.PHONY: qa-lint qa-unit qa-all clean-cache clean qa-clean

# Variables
COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-bash
PROJECT_DIR ?= $(CURDIR)
export QA_UID := $(shell id -u)
export QA_GID := $(shell id -g)

qa-lint:
	@echo "🔍 Ejecutando Linter y Formateo (ShellCheck + shfmt)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T $(SERVICE_NAME) bash -c "shopt -s globstar nullglob && shellcheck **/*.sh && shfmt -d **/*.sh"

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias y Cobertura >= 95% (BATS + kcov)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T $(SERVICE_NAME) bash -c 'rm -rf coverage_report; rc=0; kcov --include-path="$$PWD" --exclude-pattern="$$PWD/test" -l 80,95 coverage_report/ bats test/ >/tmp/bats-tap.log 2>/tmp/kcov-stderr.log || rc=$$?; cat /tmp/bats-tap.log; if [ "$${rc}" -ne 0 ]; then if ! grep -q "^not ok " /tmp/bats-tap.log 2>/dev/null; then tail -n 40 /tmp/kcov-stderr.log >&2; fi; exit "$${rc}"; fi; /usr/bin/python3 -c "import json, pathlib, re, sys; r = pathlib.Path(\"coverage_report\"); jf = [p for p in sorted(r.rglob(\"coverage.json\")) if not p.parent.is_symlink()]; xf = [p for p in sorted(r.rglob(\"cobertura.xml\")) if not p.parent.is_symlink()]; ds = [json.loads(p.read_text()) for p in jf]; tot = sum(int(d.get(\"total_lines\", 0)) for d in ds); pct = (sum(int(d.get(\"covered_lines\", 0)) for d in ds) * 100.0 / tot if tot > 0 else float(ds[0].get(\"percent_covered\", 0))) if ds else (float(m.group(1)) * 100.0 if (xf and (m := re.search(r\"<coverage[^>]*line-rate=.([0-9.]+)\", xf[0].read_text()))) else -1.0); print(f\"Cobertura kcov: {pct:.2f}% (umbral >= 95.0%)\"); sys.exit(0 if pct >= 95.0 else 1)"'

qa-all: qa-lint qa-unit
	@echo "✅ Pipeline QA Bash completado."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true
	@rm -rf coverage_report/

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
