.PHONY: qa-lint qa-unit qa-all clean-cache clean qa-clean

# Variables
COMPOSE_FILE = docker-compose.qa.yml
SERVICE_NAME = qa-bash

qa-lint:
	@echo "🔍 Ejecutando Linter y Formateo (ShellCheck + shfmt)..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) bash -c "shopt -s globstar nullglob && shellcheck **/*.sh && shfmt -d **/*.sh"

qa-unit:
	@echo "🧪 Ejecutando Pruebas Unitarias y Cobertura (BATS + kcov)..."
	@docker compose -f $(COMPOSE_FILE) run --rm $(SERVICE_NAME) bash -c "kcov coverage_report/ bats test/"

qa-all: qa-lint qa-unit
	@echo "✅ Pipeline QA Bash completado."

clean-cache:
	@docker compose -f $(COMPOSE_FILE) down -v >/dev/null 2>&1 || true
	@rm -rf coverage_report/

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
