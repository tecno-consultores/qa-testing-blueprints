[tox]
env_list = py310, py311, py312, py313
isolated_build = True

[testenv]
description = Instala dependencias con uv y ejecuta la auditoría estática y pruebas lógicas
deps = 
    .[dev]
commands =
    # 1. Calidad de código
    ruff check src/ tests/
    ruff format --check src/ tests/
    # 2. Análisis estricto de tipos
    mypy --strict src/
    # 3. Auditoría de seguridad de dependencias y código
    uv pip audit
    bandit -c pyproject.toml -r src/
    # 4. Suite unitaria e integración (Cobertura 95%)
    pytest --cov=src/ --cov-fail-under=95 --cov-report=term-missing
