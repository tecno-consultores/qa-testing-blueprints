[project]
name = "python-qa-blueprint"
version = "0.2.0"
description = "Plantilla base corporativa (11X) para scripts de Python con pruebas exhaustivas, BDD, y Profiling"
readme = "README.md"
requires-python = ">=3.13"
dependencies = [
    "requests>=2.31.0",
    "python-dotenv>=1.0.0",
]

[project.optional-dependencies]
dev = [
    # Core Testing & Mocking
    "pytest>=8.0.0",
    "pytest-cov>=4.1.0",
    "pytest-mock>=3.14.0",
    
    # BDD & Benchmarking
    "pytest-bdd>=7.1.2",
    "pytest-benchmark>=4.0.0",
    
    # Linting & Typing
    "ruff>=0.3.0",
    "mypy>=1.9.0",
    
    # QA Matrices
    "tox>=4.14.0",
    "tox-uv>=1.16.0",
    
    # Security & Mutation
    "bandit>=1.7.8",
    "pip-audit>=2.7.3",
    "mutmut>=2.4.5,<3.0.0",
    
    # Complexity & Profiling
    "radon>=6.0.1",
    "py-spy>=0.3.14",
    
    # Observability & Metrics (Nivel 11X)
    "prometheus-client>=0.20.0"
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src"]

[tool.pytest.ini_options]
python_files = ["*.unit.py", "*.spec.py", "test_*.py"]
pythonpath = ["."]
addopts = "--import-mode=importlib --strict-markers --cov=src/ --cov-report=html --cov-report=term-missing"
markers = [
    "integration: Pruebas que requieren conexión a internet (deseleccionar con '-m \"not integration\"')",
    "bdd: Pruebas de comportamiento Gherkin",
    "benchmark: Pruebas de rendimiento interno"
]
testpaths = ["tests"]

[tool.ruff]
line-length = 120
target-version = "py313"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B"]
ignore = ["E501"]

[tool.mypy]
strict = true

[tool.mutmut]
paths_to_mutate = "src/"
backup = false
runner = "python -m pytest -x"
tests_dir = "tests/"

[tool.pyrefly]
search-path = ["."]
python-version = "3.13"

[tool.pyrefly.errors]
missing-import = false
missing-module-attribute = false
