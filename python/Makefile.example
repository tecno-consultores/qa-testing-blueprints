.PHONY: qa-lint qa-unit qa-ci qa-mutation qa-load qa-observability qa-profile qa-sbom qa-all clean-cache clean qa-clean

# Variables
COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-backend
PROJECT_DIR ?= $(CURDIR)
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
export QA_UID QA_GID

qa-lint:
	@echo "🔍 [11X] Ejecutando Linter, Types, Complejidad Grado A, Bandit SAST y CVEs..."
	@[ ! -x ./scripts/verificar-secretos.sh ] || ./scripts/verificar-secretos.sh
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run ruff check src/ tests/ && \
		uv run ruff format --check src/ tests/ && \
		uv run mypy --strict --cache-dir=/tmp/mypy src/ && \
		test -z \"\$$(uv run radon cc --min B src/)\" && \
		test -z \"\$$(uv run radon mi --min B src/)\" && \
		uv run bandit -c pyproject.toml -q -r src/ && \
		uv run pip-audit"

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias y Cobertura >= 95% (Pytest)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app/src $(SERVICE_NAME) bash -c "uv sync --all-extras -q && uv run pytest -q --tb=short -m 'not integration' --cov-report=term-missing:skip-covered"

qa-ci: qa-lint qa-unit
	@echo "✅ [11X] Paridad Pre-Push 1:1 con CI (lint + unit) certificada."

qa-mutation:
	@echo "👽 Ejecutando Pruebas de Mutación (Mutmut + Gate MSI >= 80%)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app/src $(SERVICE_NAME) bash -c "uv sync --all-extras -q && uv run mutmut run && (uv run mutmut results --all true || uv run mutmut results) && ( [ ! -f mutmut_gates.py ] || uv run python3 mutmut_gates.py )"

qa-profile:
	@echo "🔥 [11X] Capturando Flamegraph py-spy sobre proceso Python (reports/flamegraph.svg)..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@sh -c 'set -eu; trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile profile down -v --remove-orphans >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile profile up -d --wait python-api; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile profile run --rm -T profiler'

qa-sbom:
	@echo "📜 [11X] Generando SBOM CycloneDX..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "uv sync --all-extras -q && uv run cyclonedx-py environment --of JSON -o reports/sbom.cdx.json"

qa-load:
	@echo "⚡ [11X] Ejecutando pruebas de carga k6 (perfil $(or $(K6_PROFILE),smoke))..."
	@mkdir -p "$(PROJECT_DIR)/reports"
	@if [ -z "$${API_BASE_URL:-}" ] && [ -z "$${PYTHON_HTTP_CMD:-}" ]; then \
		echo "ℹ️  [11X] Sin API_BASE_URL ni PYTHON_HTTP_CMD; validando contra stub HTTP python-api..." >&2; \
	fi
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile load down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile load up -d --wait python-api && \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile load run --rm -T -u "$(QA_UID):$(QA_GID)" k6-smoke'

qa-observability:
	@echo "📈 [11X] Levantando observabilidad (Prometheus + Pushgateway)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile observability up -d --wait

qa-all: qa-lint qa-unit qa-mutation
	@echo "✅ Pipeline QA Python Standalone completado."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
