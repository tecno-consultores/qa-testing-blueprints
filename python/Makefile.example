.PHONY: qa-lint qa-unit qa-ci qa-mutation qa-load qa-observability qa-all clean-cache clean qa-clean

# Variables
COMPOSE_FILE ?= docker-compose.qa.yml
SERVICE_NAME ?= qa-backend
PROJECT_DIR ?= $(CURDIR)
QA_UID ?= $(shell id -u)
QA_GID ?= $(shell id -g)
export QA_UID QA_GID

qa-lint:
	@echo "🔍 [11X] Ejecutando Linter, Types, Complejidad Grado A, Bandit SAST y CVEs..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "\
		uv sync --all-extras -q && \
		uv run ruff check src/ tests/ && \
		uv run ruff format --check src/ tests/ && \
		uv run mypy --strict --cache-dir=/tmp/mypy src/ && \
		test -z \"\$$(uv run radon cc --min B src/)\" && \
		test -z \"\$$(uv run radon mi --min B src/)\" && \
		uv run bandit -c pyproject.toml -q -r src/ && \
		uv run pip-audit"

qa-unit:
	@echo "🧪 [11X] Ejecutando Pruebas Unitarias y Cobertura >= 95% (Pytest)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" -e COVERAGE_FILE=/tmp/.coverage -e PYTHONPATH=/app/src $(SERVICE_NAME) bash -c "uv sync --all-extras -q && uv run pytest -q --tb=short --import-mode=importlib -m 'not integration' --cov=src --cov-fail-under=95 --cov-report=term-missing:skip-covered --cov-report=html:/tmp/htmlcov"

qa-ci: qa-lint qa-unit
	@echo "✅ [11X] Paridad Pre-Push 1:1 con CI (lint + unit) certificada."

qa-mutation:
	@echo "👽 Ejecutando Pruebas de Mutación (Mutmut)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" run --rm -T -u "$(QA_UID):$(QA_GID)" $(SERVICE_NAME) bash -c "uv sync --all-extras -q && uv run mutmut run && uv run mutmut results"

qa-load:
	@echo "⚡ [11X] Ejecutando pruebas de carga k6 (perfil $(or $(K6_PROFILE),smoke))..."
	@bash -c 'trap "docker compose --project-directory \"$(PROJECT_DIR)\" -f \"$(COMPOSE_FILE)\" --profile load down -v >/dev/null 2>&1 || true" EXIT; \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile load up --abort-on-container-exit --exit-code-from k6-smoke'

qa-observability:
	@echo "📈 [11X] Levantando observabilidad (Prometheus + Pushgateway)..."
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile observability up -d

qa-all: qa-lint qa-unit qa-mutation
	@echo "✅ Pipeline QA Python Standalone completado."

clean-cache:
	@docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" --profile "*" down -v >/dev/null 2>&1 || \
		docker compose --project-directory "$(PROJECT_DIR)" -f "$(COMPOSE_FILE)" down -v >/dev/null 2>&1 || true

clean: clean-cache
	@./limpieza.sh

qa-clean: clean
